<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Create Account | SmartDine</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css"
    >

    <style>
        body {
            background: #f8f9fa;
        }

        .register-box {
            max-width: 500px;
            margin: 60px auto;
        }

        .logo {
            width: 55px;
            height: 55px;
            background: #ff4b16;
            color: white;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: auto;
            font-size: 24px;
        }

        .register-card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
        }

        .register-btn {
            background: #ff4b16;
            border: none;
            padding: 12px;
        }

        .register-btn:hover {
            background: #e94310;
        }
    </style>
</head>

<body>
    

    <%- include("../includes/flash.ejs") %>

    <div class="container">

        <div class="register-box">

            <div class="card register-card">

                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">

                        <div class="logo mb-3">
                            <i class="fa-solid fa-utensils"></i>
                        </div>

                        <h2 class="fw-bold">
                            Create Account
                        </h2>

                        <p class="text-muted">
                            Join SmartDine and order your favourite food
                        </p>

                    </div>

                    <form action="/customer/register" method="POST">

                        <div class="mb-3">
                            <label class="form-label">
                                Full Name
                            </label>

                            <input
                                type="text"
                                name="name"
                                class="form-control"
                                placeholder="Enter your full name"
                                required
                            >
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Email Address
                            </label>

                            <input
                                type="email"
                                name="email"
                                class="form-control"
                                placeholder="Enter your email"
                                required
                            >
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Phone Number
                            </label>

                            <input
                                type="tel"
                                name="phone"
                                class="form-control"
                                placeholder="Enter your phone number"
                                required
                            >
                        </div>

                        <div class="mb-4">
                            <label class="form-label">
                                Password
                            </label>

                            <input
                                type="password"
                                name="password"
                                class="form-control"
                                placeholder="Create a password"
                                minlength="6"
                                required
                            >
                        </div>

                        <button
                            type="submit"
                            class="btn register-btn text-white w-100"
                        >
                            Create Account
                        </button>

                    </form>

                    <div class="text-center mt-4">

                        <span class="text-muted">
                            Already have an account?
                        </span>

                        <a
                            href="/customer/login"
                            class="text-danger fw-semibold text-decoration-none"
                        >
                            Login
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</body>
</html>