<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Orders & Donations | SmartDine</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css">

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f8f8f8;
            color: #222;
            font-family: "Plus Jakarta Sans", sans-serif;
        }

        .orders-container {
            max-width: 1000px;
            margin: auto;
            padding: 45px 25px 80px;
        }

        .page-title {
            font-size: 30px;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .page-subtitle {
            color: #777;
            font-size: 14px;
            margin-bottom: 30px;
        }

        .section-title {
            font-size: 22px;
            font-weight: 800;
            margin: 35px 0 20px;
        }

        .order-card {
            background: #fff;
            border-radius: 12px;
            padding: 24px;
            margin-bottom: 20px;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06);
        }

        .order-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            padding-bottom: 18px;
            border-bottom: 1px solid #eee;
        }

        .restaurant-name {
            font-size: 18px;
            font-weight: 800;
            margin-bottom: 5px;
        }

        .order-date {
            color: #888;
            font-size: 12px;
        }

        .status {
            display: inline-block;
            padding: 7px 13px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            text-align: center;
        }

        .status-pending {
            background: #fff3cd;
            color: #856404;
        }

        .status-confirmed,
        .status-approved {
            background: #dbeafe;
            color: #1d4ed8;
        }

        .status-preparing {
            background: #ffedd5;
            color: #c2410c;
        }

        .status-departed,
        .status-accepted {
            background: #e2d9f3;
            color: #59359a;
        }

        .status-completed {
            background: #dcfce7;
            color: #15803d;
        }

        .status-cancelled,
        .status-rejected {
            background: #fee2e2;
            color: #b91c1c;
        }

        .status-pickup {
            background: #cffafe;
            color: #155e75;
        }

        .status-not-required {
            background: #f3f4f6;
            color: #4b5563;
        }

        .order-items {
            padding: 18px 0;
        }

        .order-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            padding: 9px 0;
            font-size: 14px;
        }

        .item-name {
            font-weight: 600;
        }

        .item-quantity {
            color: #777;
            margin-left: 8px;
        }

        .item-price {
            font-weight: 700;
            white-space: nowrap;
        }

        .order-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid #eee;
            padding-top: 18px;
        }

        .total-label {
            color: #777;
            font-size: 13px;
        }

        .total-price {
            font-size: 19px;
            font-weight: 800;
        }

        .donation-message {
            margin-top: 12px;
            padding: 12px;
            background: #f0fdf4;
            color: #166534;
            border-radius: 8px;
            font-size: 13px;
        }

        .empty-orders {
            background: #fff;
            text-align: center;
            padding: 55px 20px;
            border-radius: 12px;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.05);
            margin-bottom: 25px;
        }

        .empty-orders i {
            font-size: 45px;
            color: #ff4b16;
            margin-bottom: 18px;
        }

        .empty-orders h3 {
            font-weight: 800;
            margin-bottom: 8px;
        }

        .empty-orders p {
            color: #777;
            font-size: 14px;
            margin-bottom: 22px;
        }

        .browse-btn {
            display: inline-block;
            padding: 11px 20px;
            background: #ff4b16;
            color: #fff;
            text-decoration: none;
            border-radius: 7px;
            font-size: 13px;
            font-weight: 700;
        }

        .browse-btn:hover {
            background: #e94310;
            color: #fff;
        }

        .donation-icon {
            color: #16a34a;
            margin-right: 7px;
        }

        @media (max-width: 600px) {
            .orders-container {
                padding: 30px 15px 60px;
            }

            .page-title {
                font-size: 25px;
            }

            .section-title {
                font-size: 20px;
            }

            .order-card {
                padding: 18px;
            }

            .order-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .order-footer {
                align-items: flex-start;
                gap: 10px;
            }

            .order-item {
                font-size: 13px;
            }
        }
    </style>
</head>

<body>

    <%- include("../includes/flash.ejs") %>
    <%- include("../includes/customerNavbar.ejs") %>

    <div class="orders-container">

        <h1 class="page-title">
            My Orders & Donations
        </h1>

        <p class="page-subtitle">
            Track your food orders and follow the progress of your food donations.
        </p>


        <!-- ================= MY ORDERS ================= -->

        <h2 class="section-title">
            <i class="fa-solid fa-receipt"></i>
            My Orders
        </h2>

        <% if (orders && orders.length > 0) { %>

            <% orders.forEach(order => { %>

                <div class="order-card">

                    <div class="order-header">

                        <div>
                            <div class="restaurant-name">
                                <%= order.restaurant?.restaurantName || "Restaurant" %>
                            </div>

                            <div class="order-date">
                                Ordered on
                                <%= new Date(order.createdAt).toLocaleDateString("en-IN") %>
                            </div>
                        </div>

                        <div>
                            <% if (order.status === "Pending") { %>

                                <span class="status status-pending">Pending</span>

                            <% } else if (order.status === "Confirmed") { %>

                                <span class="status status-confirmed">Confirmed</span>

                            <% } else if (order.status === "Preparing") { %>

                                <span class="status status-preparing">Preparing</span>

                            <% } else if (order.status === "Departed") { %>

                                <span class="status status-departed">Departed</span>

                            <% } else if (order.status === "Completed") { %>

                                <span class="status status-completed">Completed</span>

                            <% } else if (order.status === "Cancelled") { %>

                                <span class="status status-cancelled">Cancelled</span>

                            <% } else { %>

                                <span class="status status-pending">
                                    <%= order.status %>
                                </span>

                            <% } %>
                        </div>

                    </div>

                    <div class="order-items">

                        <% (order.items || []).forEach(item => { %>

                            <div class="order-item">

                                <div>
                                    <span class="item-name">
                                        <%= item.name || item.foodItem?.name || "Food Item" %>
                                    </span>

                                    <span class="item-quantity">
                                        × <%= item.quantity %>
                                    </span>
                                </div>

                                <div class="item-price">
                                    ₹<%= Number(item.price || 0) * Number(item.quantity || 0) %>
                                </div>

                            </div>

                        <% }) %>

                    </div>

                    <div class="order-footer">

                        <div class="total-label">
                            Total Amount
                        </div>

                        <div class="total-price">
                            ₹<%= order.totalAmount ?? 0 %>
                        </div>

                    </div>

                </div>

            <% }) %>

        <% } else { %>

            <div class="empty-orders">

                <i class="fa-solid fa-receipt"></i>

                <h3>No Orders Yet</h3>

                <p>You haven't placed any food orders yet.</p>

                <a href="/customer/restaurants" class="browse-btn">
                    Browse Restaurants
                </a>

            </div>

        <% } %>


        <!-- ================= MY DONATIONS ================= -->

        <h2 class="section-title">
            <i class="fa-solid fa-heart donation-icon"></i>
            My Donations
        </h2>

        <% if (typeof donations !== "undefined" && donations.length > 0) { %>

            <% donations.forEach(donation => { %>

                <div class="order-card">

                    <div class="order-header">

                        <div>
                            <div class="restaurant-name">
                                <i class="fa-solid fa-utensils donation-icon"></i>
                                <%= donation.restaurant?.restaurantName || "Restaurant" %>
                            </div>

                            <div class="order-date">
                                Donation submitted on
                                <%= new Date(donation.createdAt).toLocaleDateString("en-IN") %>
                            </div>

                            <div class="order-date mt-1">
                                Donation type:
                                <%= donation.donationType === "Customer" ? "Customer Donation" : "Restaurant Donation" %>
                            </div>
                        </div>

                        <div>
                            <% 
                                let donationStatus = "";
                                let donationStatusClass = "status-pending";

                                if (donation.status === "Cancelled") {
                                    donationStatus = "Cancelled";
                                    donationStatusClass = "status-cancelled";

                                } else if (donation.approvalStatus === "Rejected") {
                                    donationStatus = "Rejected by Restaurant";
                                    donationStatusClass = "status-rejected";

                                } else if (donation.approvalStatus === "Pending") {
                                    donationStatus = "Pending Restaurant Approval";
                                    donationStatusClass = "status-pending";

                                } else if (donation.status === "Completed") {
                                    donationStatus = "Donation Completed";
                                    donationStatusClass = "status-completed";

                                } else if (donation.status === "Pickup Confirmed") {
                                    donationStatus = "Pickup Confirmed";
                                    donationStatusClass = "status-pickup";

                                } else if (donation.status === "Accepted") {
                                    donationStatus = "Accepted by NGO";
                                    donationStatusClass = "status-accepted";

                                } else if (donation.approvalStatus === "Approved") {
                                    donationStatus = "Approved — Waiting for NGO";
                                    donationStatusClass = "status-approved";

                                } else if (donation.approvalStatus === "NotRequired") {
                                    donationStatus = "Available for NGO";
                                    donationStatusClass = "status-not-required";

                                } else {
                                    donationStatus = donation.status || "Pending";
                                    donationStatusClass = "status-pending";
                                }
                            %>

                            <span class="status <%= donationStatusClass %>">
                                <%= donationStatus %>
                            </span>
                        </div>

                    </div>

                    <div class="order-items">

                        <% (donation.items || []).forEach(item => { %>

                            <div class="order-item">

                                <div>
                                    <span class="item-name">
                                        <%= item.name || item.foodItem?.name || "Food Item" %>
                                    </span>

                                    <span class="item-quantity">
                                        × <%= item.quantity %>
                                    </span>
                                </div>

                                <div class="item-price">
                                    <%= donation.donationType === "Customer" ? "₹" + (Number(item.price || 0) * Number(item.quantity || 0)) : (Number(item.price || 0) * Number(item.quantity || 0) > 0 ? "₹" + (Number(item.price || 0) * Number(item.quantity || 0)) : "Donated") %>
                                </div>

                            </div>

                        <% }) %>

                    </div>

                    <% if (donation.message) { %>
                        <div class="donation-message">
                            <i class="fa-solid fa-heart"></i>
                            <%= donation.message %>
                        </div>
                    <% } %>

                    <div class="order-footer">

                        <div class="total-label">
                            Donation Status
                        </div>

                        <div class="total-price" style="font-size: 14px;">
                            <% if (donation.approvalStatus === "Rejected") { %>
                                Request rejected
                            <% } else if (donation.status === "Completed") { %>
                                Thank you for donating!
                            <% } else if (donation.status === "Pickup Confirmed") { %>
                                Awaiting pickup completion
                            <% } else if (donation.status === "Accepted") { %>
                                NGO is arranging pickup
                            <% } else if (donation.approvalStatus === "Pending") { %>
                                Waiting for restaurant
                            <% } else if (donation.approvalStatus === "Approved") { %>
                                Waiting for NGO
                            <% } else { %>
                                Helping reduce food waste
                            <% } %>
                        </div>

                    </div>

                </div>

            <% }) %>

        <% } else { %>

            <div class="empty-orders">

                <i class="fa-solid fa-heart"></i>

                <h3>No Donations Yet</h3>

                <p>Your food donations will appear here once you submit a donation request.</p>

                <a href="/customer/restaurants" class="browse-btn">
                    Explore Restaurants
                </a>

            </div>

        <% } %>

    </div>

    <%- include("../includes/customerFooter.ejs") %>

</body>
</html>