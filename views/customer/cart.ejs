<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Cart | SmartDine</title>

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <!-- Font Awesome -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <!-- Google Fonts -->
    <link
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f8f8f8;
            font-family: "Plus Jakarta Sans", sans-serif;
            color: #222;
        }

        .cart-page {
            max-width: 1100px;
            margin: auto;
            padding: 40px 25px 70px;
            min-height: 65vh;
        }

        .cart-title {
            font-size: 30px;
            font-weight: 800;
            margin-bottom: 30px;
        }

        .cart-layout {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 330px;
            gap: 25px;
            align-items: start;
        }

        .cart-items {
            background: white;
            border-radius: 12px;
            padding: 10px 20px;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
        }

        .cart-item {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 20px 0;
            border-bottom: 1px solid #eeeeee;
        }

        .cart-item:last-child {
            border-bottom: none;
        }

        .food-image {
            width: 100px;
            height: 80px;
            object-fit: cover;
            border-radius: 9px;
            flex-shrink: 0;
        }

        .food-placeholder {
            width: 100px;
            height: 80px;
            border-radius: 9px;
            background: #fff1eb;
            color: #ff4b16;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            flex-shrink: 0;
        }

        .food-info {
            flex: 1;
            min-width: 0;
        }

        .food-name {
            font-size: 16px;
            font-weight: 800;
            margin-bottom: 6px;
            overflow-wrap: anywhere;
        }

        .food-price {
            font-size: 14px;
            color: #666;
        }

        .quantity-box {
            display: flex;
            align-items: center;
            border: 1px solid #ddd;
            border-radius: 7px;
            overflow: hidden;
            flex-shrink: 0;
        }

        .quantity-form,
        .remove-form {
            margin: 0;
        }

        .quantity-btn {
            width: 32px;
            height: 32px;
            border: none;
            background: white;
            color: #ff4b16;
            font-size: 18px;
            font-weight: 700;
            cursor: pointer;
        }

        .quantity-btn:hover {
            background: #fff2ec;
        }

        .quantity {
            min-width: 30px;
            text-align: center;
            font-size: 13px;
            font-weight: 700;
        }

        .item-total {
            min-width: 75px;
            text-align: right;
            font-size: 14px;
            font-weight: 800;
            white-space: nowrap;
        }

        .remove-btn {
            border: none;
            background: transparent;
            color: #e53935;
            font-size: 15px;
            padding: 7px;
            cursor: pointer;
        }

        .remove-btn:hover {
            color: #b71c1c;
        }

        .summary {
            background: white;
            border-radius: 12px;
            padding: 22px;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
            position: sticky;
            top: 20px;
        }

        .summary-title {
            font-size: 19px;
            font-weight: 800;
            margin-bottom: 22px;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            gap: 15px;
            margin-bottom: 14px;
            font-size: 14px;
            color: #666;
        }

        .summary-row span:last-child {
            font-weight: 600;
            color: #333;
        }

        .summary-total {
            display: flex;
            justify-content: space-between;
            gap: 15px;
            border-top: 1px solid #eeeeee;
            padding-top: 17px;
            margin-top: 17px;
            font-size: 18px;
            font-weight: 800;
            color: #222;
        }

        .checkout-btn,
        .donate-btn {
            display: block;
            width: 100%;
            border: none;
            color: white;
            padding: 14px;
            border-radius: 7px;
            margin-top: 18px;
            font-size: 14px;
            font-weight: 700;
            text-align: center;
            text-decoration: none;
            cursor: pointer;
            transition: background 0.2s ease;
        }

        .checkout-btn {
            background: #ff4b16;
        }

        .checkout-btn:hover {
            background: #e94310;
            color: white;
        }

        .donate-btn {
            background: #198754;
            margin-top: 12px;
        }

        .donate-btn:hover {
            background: #146c43;
            color: white;
        }

        .continue-shopping {
            display: block;
            text-align: center;
            margin-top: 15px;
            color: #555;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
        }

        .continue-shopping:hover {
            color: #ff4b16;
        }

        .empty-cart {
            background: white;
            border-radius: 12px;
            padding: 80px 20px;
            text-align: center;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
        }

        .empty-cart i {
            color: #ff4b16;
            font-size: 55px;
            margin-bottom: 20px;
        }

        .empty-cart h3 {
            font-weight: 800;
            margin-bottom: 10px;
        }

        .empty-cart p {
            color: #777;
            font-size: 14px;
        }

        .continue-btn {
            display: inline-block;
            margin-top: 15px;
            padding: 12px 22px;
            background: #ff4b16;
            color: white;
            border-radius: 7px;
            text-decoration: none;
            font-size: 13px;
            font-weight: 700;
        }

        .continue-btn:hover {
            color: white;
            background: #e94310;
        }

        @media (max-width: 850px) {
            .cart-layout {
                grid-template-columns: 1fr;
            }

            .summary {
                position: static;
            }
        }

        @media (max-width: 600px) {
            .cart-page {
                padding: 25px 15px 45px;
            }

            .cart-title {
                font-size: 25px;
            }

            .cart-items {
                padding: 8px 14px;
            }

            .cart-item {
                flex-wrap: wrap;
                gap: 12px;
            }

            .food-image,
            .food-placeholder {
                width: 80px;
                height: 70px;
            }

            .food-info {
                flex: 1;
                min-width: 0;
            }

            .food-name {
                font-size: 14px;
            }

            .quantity-box {
                margin-left: 92px;
            }

            .item-total {
                margin-left: auto;
            }

            .summary {
                padding: 18px;
            }
        }
    </style>
</head>

<body>

    <%- include("../includes/customerNavbar.ejs") %>
    <%- include("../includes/flash.ejs") %>

    <main class="cart-page">

        <h1 class="cart-title">
            Your Cart
        </h1>

        <% if (cart && cart.length > 0) { %>

            <div class="cart-layout">

                <!-- CART ITEMS -->
                <section class="cart-items">

                    <% cart.forEach(item => { %>

                        <article class="cart-item">

                            <!-- FOOD IMAGE -->
                            <%
                                const foodImage = typeof item.image === "string"
                                    ? item.image
                                    : item.image?.url;
                            %>

                            <% if (foodImage) { %>

                                <img
                                    src="<%= foodImage %>"
                                    alt="<%= item.name %>"
                                    class="food-image"
                                    onerror="this.onerror=null; this.style.display='none'; this.nextElementSibling.style.display='flex';">

                                <div class="food-placeholder" style="display:none;">
                                    <i class="fa-solid fa-bowl-food"></i>
                                </div>

                            <% } else { %>

                                <div class="food-placeholder">
                                    <i class="fa-solid fa-bowl-food"></i>
                                </div>

                            <% } %>

                            <!-- FOOD DETAILS -->
                            <div class="food-info">

                                <div class="food-name">
                                    <%= item.name %>
                                </div>

                                <div class="food-price">
                                    ₹<%= Number(item.price).toFixed(2) %> each
                                </div>

                            </div>

                            <!-- QUANTITY CONTROLS -->
                            <div class="quantity-box">

                                <form
                                    action="/customer/cart/decrease/<%= item.itemId %>"
                                    method="POST"
                                    class="quantity-form">

                                    <button
                                        type="submit"
                                        class="quantity-btn"
                                        aria-label="Decrease quantity">
                                        −
                                    </button>

                                </form>

                                <span class="quantity">
                                    <%= item.quantity %>
                                </span>

                                <form
                                    action="/customer/cart/increase/<%= item.itemId %>"
                                    method="POST"
                                    class="quantity-form">

                                    <button
                                        type="submit"
                                        class="quantity-btn"
                                        aria-label="Increase quantity">
                                        +
                                    </button>

                                </form>

                            </div>

                            <!-- ITEM TOTAL -->
                            <div class="item-total">
                                ₹<%= (Number(item.price) * Number(item.quantity)).toFixed(2) %>
                            </div>

                            <!-- REMOVE ITEM -->
                            <form
                                action="/customer/cart/remove/<%= item.itemId %>"
                                method="POST"
                                class="remove-form">

                                <button
                                    type="submit"
                                    class="remove-btn"
                                    aria-label="Remove <%= item.name %> from cart"
                                    title="Remove item">

                                    <i class="fa-solid fa-trash"></i>

                                </button>

                            </form>

                        </article>

                    <% }) %>

                </section>

                <!-- ORDER SUMMARY -->
                <aside class="summary">

                    <h2 class="summary-title">
                        Order Summary
                    </h2>

                    <div class="summary-row">

                        <span>Items</span>

                        <span>
                            <%= cart.reduce((total, item) => total + Number(item.quantity), 0) %>
                        </span>

                    </div>

                    <div class="summary-row">

                        <span>Subtotal</span>

                        <span>
                            ₹<%= cart.reduce((total, item) => total + (Number(item.price) * Number(item.quantity)), 0).toFixed(2) %>
                        </span>

                    </div>

                    <div class="summary-total">

                        <span>Total</span>

                        <span>
                            ₹<%= cart.reduce((total, item) => total + (Number(item.price) * Number(item.quantity)), 0).toFixed(2) %>
                        </span>

                    </div>

                    <!-- EXISTING ORDER BUTTON -->
                    <a href="/customer/payment" class="checkout-btn">
                        <i class="fa-solid fa-bag-shopping me-2"></i>
                        Place Order
                        <i class="fa-solid fa-arrow-right ms-2"></i>
                    </a>

                    <!-- NEW DONATION BUTTON -->
                    <a href="/customer/donation/payment" class="donate-btn">
                        <i class="fa-solid fa-hand-holding-heart me-2"></i>
                        Donate Food
                    </a>

                    <a href="/customer/restaurants" class="continue-shopping">
                        <i class="fa-solid fa-arrow-left me-1"></i>
                        Continue Shopping
                    </a>

                </aside>

            </div>

        <% } else { %>

            <!-- EMPTY CART -->
            <section class="empty-cart">

                <i class="fa-solid fa-cart-shopping"></i>

                <h3>Your Cart is Empty</h3>

                <p>
                    Add some delicious food to your cart.
                </p>

                <a href="/customer/restaurants" class="continue-btn">
                    Browse Restaurants
                </a>

            </section>

        <% } %>

    </main>

    <%- include("../includes/customerFooter.ejs") %>

</body>

</html>