<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Payment | SmartDine</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css"
    >

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f8f8f8;
            font-family: Arial, sans-serif;
        }

        .payment-container {
            max-width: 700px;
            margin: 50px auto;
            padding: 0 20px;
        }

        .payment-card {
            background: #fff;
            padding: 30px;
            border-radius: 14px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        }

        .payment-title {
            font-weight: 800;
            margin-bottom: 25px;
        }

        .payment-option {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 16px;
            border: 1px solid #ddd;
            border-radius: 9px;
            margin-bottom: 12px;
            cursor: pointer;
            transition: 0.2s;
        }

        .payment-option:hover {
            border-color: #ff4b16;
        }

        .payment-option.selected {
            border: 2px solid #ff4b16;
            background: #fff5f0;
        }

        .payment-option input {
            width: 18px;
            height: 18px;
            accent-color: #ff4b16;
        }

        .payment-option i {
            font-size: 22px;
            color: #ff4b16;
        }

        .payment-option-content {
            flex: 1;
        }

        .payment-option-title {
            font-weight: 700;
            margin-bottom: 3px;
        }

        .payment-option-text {
            font-size: 13px;
            color: #777;
        }

        .payment-details {
            display: none;
            padding: 15px;
            margin-top: -5px;
            margin-bottom: 15px;
            border: 1px solid #eee;
            border-radius: 8px;
            background: #fafafa;
        }

        .payment-details.show {
            display: block;
        }

        .card-details {
            display: none;
        }

        .card-details.show {
            display: block;
        }

        .upi-options {
            display: none;
            margin-top: 5px;
        }

        .upi-options.show {
            display: block;
        }

        .upi-title {
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .upi-option {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 8px;
            margin-bottom: 8px;
            cursor: pointer;
            background: #fff;
        }

        .upi-option:hover {
            border-color: #ff4b16;
        }

        .upi-option.selected {
            border: 2px solid #ff4b16;
            background: #fff5f0;
        }

        .upi-option input {
            accent-color: #ff4b16;
        }

        .upi-icon {
            width: 35px;
            height: 35px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fff1eb;
            color: #ff4b16;
            border-radius: 7px;
        }

        .total-section {
            display: flex;
            justify-content: space-between;
            margin-top: 25px;
            padding-top: 20px;
            border-top: 1px solid #eee;
            font-size: 17px;
            font-weight: 800;
        }

        .pay-btn {
            width: 100%;
            border: none;
            padding: 13px;
            background: #ff4b16;
            color: #fff;
            border-radius: 7px;
            font-weight: 700;
            margin-top: 20px;
        }

        .pay-btn:hover {
            background: #e94310;
        }
    </style>
</head>

<body>
    <%- include("../includes/flash.ejs") %>
    <%- include("../includes/customerNavbar.ejs") %>

<div class="payment-container">

    <div class="payment-card">

        <h2 class="payment-title">
            Choose Payment Method
        </h2>

        <form action="/customer/donation/payment/success" method="POST" id="paymentForm">

            <!-- DEBIT CARD -->

            <label class="payment-option" id="debitOption">

                <input
                    type="radio"
                    name="paymentMethod"
                    value="Debit Card"
                    onchange="selectPayment('debit')"
                >

                <i class="fa-solid fa-credit-card"></i>

                <div class="payment-option-content">

                    <div class="payment-option-title">
                        Debit Card
                    </div>

                    <div class="payment-option-text">
                        Pay securely using your debit card
                    </div>

                </div>

            </label>

            <div class="payment-details" id="debitDetails">

                <div class="card-details" id="debitCardDetails">

                    <div class="mb-3">

                        <label class="form-label">
                            Card Number
                        </label>

                        <input
                            type="text"
                            name="cardNumber"
                            class="form-control"
                            placeholder="1234 5678 9012 3456"
                        >

                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Expiry Date
                            </label>

                            <input
                                type="text"
                                name="expiry"
                                class="form-control"
                                placeholder="MM/YY"
                            >

                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                CVV
                            </label>

                            <input
                                type="password"
                                name="cvv"
                                class="form-control"
                                placeholder="CVV"
                            >

                        </div>

                    </div>

                </div>

            </div>


            <!-- CREDIT CARD -->

            <label class="payment-option" id="creditOption">

                <input
                    type="radio"
                    name="paymentMethod"
                    value="Credit Card"
                    onchange="selectPayment('credit')"
                >

                <i class="fa-solid fa-credit-card"></i>

                <div class="payment-option-content">

                    <div class="payment-option-title">
                        Credit Card
                    </div>

                    <div class="payment-option-text">
                        Pay securely using your credit card
                    </div>

                </div>

            </label>

            <div class="payment-details" id="creditDetails">

                <div class="card-details" id="creditCardDetails">

                    <div class="mb-3">

                        <label class="form-label">
                            Card Number
                        </label>

                        <input
                            type="text"
                            name="creditCardNumber"
                            class="form-control"
                            placeholder="1234 5678 9012 3456"
                        >

                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Expiry Date
                            </label>

                            <input
                                type="text"
                                name="creditExpiry"
                                class="form-control"
                                placeholder="MM/YY"
                            >

                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                CVV
                            </label>

                            <input
                                type="password"
                                name="creditCvv"
                                class="form-control"
                                placeholder="CVV"
                            >

                        </div>

                    </div>

                </div>

            </div>


            <!-- UPI -->

            <label class="payment-option" id="upiOption">

                <input
                    type="radio"
                    name="paymentMethod"
                    value="UPI"
                    onchange="selectPayment('upi')"
                >

                <i class="fa-solid fa-mobile-screen-button"></i>

                <div class="payment-option-content">

                    <div class="payment-option-title">
                        UPI
                    </div>

                    <div class="payment-option-text">
                        Pay using your UPI app
                    </div>

                </div>

            </label>

            <div class="payment-details" id="upiDetails">

                <div class="upi-options" id="upiOptions">

                    <div class="upi-title">
                        Select UPI App
                    </div>

                    <!-- PHONEPE -->

                    <label class="upi-option" id="phonepeOption">

                        <input
                            type="radio"
                            name="upiApp"
                            value="PhonePe"
                            onchange="selectUPI('phonepe')"
                        >

                        <div class="upi-icon">
                            <i class="fa-solid fa-mobile-screen-button"></i>
                        </div>

                        <span>
                            PhonePe
                        </span>

                    </label>

                    <!-- GOOGLE PAY -->

                    <label class="upi-option" id="gpayOption">

                        <input
                            type="radio"
                            name="upiApp"
                            value="Google Pay"
                            onchange="selectUPI('gpay')"
                        >

                        <div class="upi-icon">
                            <i class="fa-brands fa-google"></i>
                        </div>

                        <span>
                            Google Pay
                        </span>

                    </label>

                    <!-- PAYTM -->

                    <label class="upi-option" id="paytmOption">

                        <input
                            type="radio"
                            name="upiApp"
                            value="Paytm"
                            onchange="selectUPI('paytm')"
                        >

                        <div class="upi-icon">
                            <i class="fa-solid fa-wallet"></i>
                        </div>

                        <span>
                            Paytm
                        </span>

                    </label>

                </div>

            </div>


            <!-- TOTAL -->

            <div class="total-section">

                <span>
                    Total
                </span>

                <span>
                    ₹<%= total %>
                </span>

            </div>


            <!-- PAY NOW -->

            <button
                type="submit"
                class="pay-btn"
                onclick="return validatePayment()"
            >
                Pay Now
            </button>

        </form>

    </div>

</div>


<script>

    function selectPayment(method) {

        document.querySelectorAll(".payment-option").forEach(option => {
            option.classList.remove("selected");
        });

        document.querySelectorAll(".payment-details").forEach(details => {
            details.classList.remove("show");
        });

        document.querySelectorAll(".card-details").forEach(details => {
            details.classList.remove("show");
        });

        document.querySelectorAll(".upi-options").forEach(options => {
            options.classList.remove("show");
        });

        if (method === "debit") {

            document
                .getElementById("debitOption")
                .classList.add("selected");

            document
                .getElementById("debitDetails")
                .classList.add("show");

            document
                .getElementById("debitCardDetails")
                .classList.add("show");
        }

        if (method === "credit") {

            document
                .getElementById("creditOption")
                .classList.add("selected");

            document
                .getElementById("creditDetails")
                .classList.add("show");

            document
                .getElementById("creditCardDetails")
                .classList.add("show");
        }

        if (method === "upi") {

            document
                .getElementById("upiOption")
                .classList.add("selected");

            document
                .getElementById("upiDetails")
                .classList.add("show");

            document
                .getElementById("upiOptions")
                .classList.add("show");
        }
    }


    function selectUPI(app) {

        document.querySelectorAll(".upi-option").forEach(option => {
            option.classList.remove("selected");
        });

        if (app === "phonepe") {
            document
                .getElementById("phonepeOption")
                .classList.add("selected");
        }

        if (app === "gpay") {
            document
                .getElementById("gpayOption")
                .classList.add("selected");
        }

        if (app === "paytm") {
            document
                .getElementById("paytmOption")
                .classList.add("selected");
        }
    }


    function validatePayment() {

        const paymentMethod = document.querySelector(
            'input[name="paymentMethod"]:checked'
        );

        if (!paymentMethod) {
            alert("Please select a payment method.");
            return false;
        }

        if (paymentMethod.value === "UPI") {

            const upiApp = document.querySelector(
                'input[name="upiApp"]:checked'
            );

            if (!upiApp) {
                alert("Please select a UPI app.");
                return false;
            }
        }

        if (paymentMethod.value === "Debit Card") {

            const cardNumber = document.querySelector(
                'input[name="cardNumber"]'
            ).value.trim();

            const expiry = document.querySelector(
                'input[name="expiry"]'
            ).value.trim();

            const cvv = document.querySelector(
                'input[name="cvv"]'
            ).value.trim();

            if (!cardNumber || !expiry || !cvv) {
                alert("Please enter complete debit card details.");
                return false;
            }
        }

        if (paymentMethod.value === "Credit Card") {

            const cardNumber = document.querySelector(
                'input[name="creditCardNumber"]'
            ).value.trim();

            const expiry = document.querySelector(
                'input[name="creditExpiry"]'
            ).value.trim();

            const cvv = document.querySelector(
                'input[name="creditCvv"]'
            ).value.trim();

            if (!cardNumber || !expiry || !cvv) {
                alert("Please enter complete credit card details.");
                return false;
            }
        }

        return true;
    }

</script>

</body>
</html>