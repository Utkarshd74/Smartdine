<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Profile | SmartDine</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css"
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f8f8f8;
            font-family: "Plus Jakarta Sans", sans-serif;
            color: #222;
        }

        .profile-container {
            max-width: 850px;
            margin: auto;
            padding: 50px 25px;
        }

        .profile-title {
            font-size: 30px;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .profile-subtitle {
            color: #777;
            font-size: 14px;
            margin-bottom: 30px;
        }

        .profile-card {
            background: #fff;
            border-radius: 14px;
            padding: 35px;
            box-shadow: 0 4px 20px rgba(0,0,0,.06);
        }

        .profile-top {
            display: flex;
            align-items: center;
            gap: 20px;
            padding-bottom: 30px;
            border-bottom: 1px solid #eee;
            margin-bottom: 30px;
        }

        .profile-icon {
            width: 75px;
            height: 75px;
            border-radius: 50%;
            background: #ff4b16;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
        }

        .profile-name {
            font-size: 22px;
            font-weight: 800;
            margin-bottom: 5px;
        }

        .profile-role {
            color: #888;
            font-size: 13px;
        }

        .detail {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 18px 0;
            border-bottom: 1px solid #f0f0f0;
        }

        .detail:last-child {
            border-bottom: none;
        }

        .detail-icon {
            width: 42px;
            height: 42px;
            border-radius: 9px;
            background: #fff3ed;
            color: #ff4b16;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .detail-label {
            color: #888;
            font-size: 12px;
            margin-bottom: 4px;
        }

        .detail-value {
            font-size: 15px;
            font-weight: 600;
        }

        @media (max-width: 600px) {

            .profile-container {
                padding: 30px 15px;
            }

            .profile-card {
                padding: 25px 20px;
            }

            .profile-title {
                font-size: 25px;
            }
        }
    </style>
</head>

<body>
    <%- include("../includes/flash.ejs") %>

    <%- include("../includes/customerNavbar.ejs") %>

    <div class="profile-container">

        <h1 class="profile-title">
            My Profile
        </h1>

        <p class="profile-subtitle">
            View your SmartDine account details.
        </p>

        <div class="profile-card">

            <div class="profile-top">

                <div class="profile-icon">
                    <i class="fa-solid fa-user"></i>
                </div>

                <div>
                    <div class="profile-name">
                        <%= customer.name %>
                    </div>

                    <div class="profile-role">
                        SmartDine Customer
                    </div>
                </div>

            </div>

            <div class="detail">

                <div class="detail-icon">
                    <i class="fa-solid fa-user"></i>
                </div>

                <div>
                    <div class="detail-label">
                        Full Name
                    </div>

                    <div class="detail-value">
                        <%= customer.name %>
                    </div>
                </div>

            </div>

            <div class="detail">

                <div class="detail-icon">
                    <i class="fa-solid fa-envelope"></i>
                </div>

                <div>
                    <div class="detail-label">
                        Email Address
                    </div>

                    <div class="detail-value">
                        <%= customer.email %>
                    </div>
                </div>

            </div>

            <div class="detail">

                <div class="detail-icon">
                    <i class="fa-solid fa-phone"></i>
                </div>

                <div>
                    <div class="detail-label">
                        Phone Number
                    </div>

                    <div class="detail-value">
                        <%= customer.phone %>
                    </div>
                </div>

            </div>

        </div>

    </div>

    <%- include("../includes/customerFooter.ejs") %>

</body>

</html>