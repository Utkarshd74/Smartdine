
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>SmartDine | Home</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css"
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #ffffff;
            font-family: "Plus Jakarta Sans", sans-serif;
            color: #1d1d1d;
        }

        /* HERO SECTION */

        .hero {
            margin: 25px auto 0;
            max-width: 1200px;
            min-height: 420px;
            border-radius: 24px;
            background: linear-gradient(105deg, #fff3ed, #fff8f5);
            overflow: hidden;
            display: flex;
            align-items: center;
        }

        .hero-content {
            width: 52%;
            padding: 60px;
        }

        .hero-content h1 {
            font-size: 48px;
            line-height: 1.15;
            font-weight: 800;
            margin-bottom: 20px;
        }

        .hero-content h1 span {
            color: #ff4b16;
        }

        .hero-content p {
            color: #666;
            font-size: 16px;
            line-height: 1.7;
            max-width: 500px;
        }

        .search-box {
            margin-top: 28px;
            max-width: 540px;
            background: white;
            padding: 7px;
            border-radius: 12px;
            display: flex;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
        }

        .search-box input {
            flex: 1;
            min-width: 0;
            border: none;
            outline: none;
            padding: 13px 15px;
            font-size: 14px;
        }

        .search-btn {
            border: none;
            background: #ff4b16;
            color: white;
            padding: 0 28px;
            border-radius: 9px;
            font-weight: 600;
            cursor: pointer;
        }

        .hero-image {
            width: 48%;
            height: 420px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 190px;
        }

        /* FEATURES */

        .features {
            max-width: 1200px;
            margin: 35px auto 0;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .feature-card {
            text-align: center;
            padding: 25px 15px;
            border: 1px solid #eeeeee;
            border-radius: 14px;
            background: white;
        }

        .feature-icon {
            width: 55px;
            height: 55px;
            margin: auto;
            border-radius: 50%;
            background: #fff1eb;
            color: #ff4b16;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
        }

        .feature-card h5 {
            margin-top: 14px;
            font-size: 16px;
            font-weight: 700;
        }

        .feature-card p {
            margin: 0;
            color: #888;
            font-size: 13px;
        }

        /* COMMON SECTION */

        .section {
            max-width: 1200px;
            margin: 55px auto 0;
        }

        .section-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .section-heading h2 {
            font-size: 24px;
            font-weight: 800;
            margin: 0;
        }

        .view-all {
            color: #ff4b16;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
        }

        .view-all:hover {
            color: #d93608;
        }

        /* TOP CATEGORIES SLIDER */

        .category-slider-wrapper {
            position: relative;
            width: 100%;
        }

        .category-grid {
            display: flex;
            flex-wrap: nowrap;
            gap: 18px;
            overflow-x: auto;
            overflow-y: hidden;
            scroll-behavior: smooth;
            scroll-snap-type: x proximity;
            scrollbar-width: none;
            padding: 10px 4px 18px;
        }

        .category-grid::-webkit-scrollbar {
            display: none;
        }

        .category-card {
            flex: 0 0 130px;
            min-width: 0;
            border: 1px solid #f0f0f0;
            border-radius: 14px;
            padding: 14px 10px;
            text-align: center;
            background: #fff;
            scroll-snap-align: start;
            transition: transform 0.2s ease,
                        border-color 0.2s ease,
                        box-shadow 0.2s ease;
        }

        .category-card:hover {
            transform: translateY(-4px);
            border-color: #ff4b16;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.07);
        }

        .category-image {
            display: block;
            width: 94px;
            height: 94px;
            margin: 0 auto;
            border-radius: 50%;
            object-fit: cover;
            background: #fff3ed;
        }

        .category-card h6 {
            margin: 12px 0 0;
            font-weight: 700;
            font-size: 13px;
            line-height: 1.35;
            text-transform: capitalize;
            overflow-wrap: anywhere;
        }

        /* SLIDER ARROWS */

        .category-arrow {
            position: absolute;
            top: 38px;
            z-index: 2;
            display: grid;
            place-items: center;
            width: 40px;
            height: 40px;
            border: 1px solid #eee;
            border-radius: 50%;
            background: #fff;
            color: #ff4b16;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.12);
            cursor: pointer;
            transition: background 0.2s ease, color 0.2s ease;
        }

        .category-arrow:hover {
            background: #ff4b16;
            color: #fff;
        }

        .category-arrow:focus-visible {
            outline: 3px solid rgba(255, 75, 22, 0.3);
            outline-offset: 2px;
        }

        .category-arrow-left {
            left: -16px;
        }

        .category-arrow-right {
            right: -16px;
        }

        /* TOP RESTAURANTS */

        .restaurant-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .restaurant-card {
            background: white;
            border: 1px solid #eeeeee;
            border-radius: 14px;
            overflow: hidden;
            transition: 0.2s;
        }

        .restaurant-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
        }

        .restaurant-image {
            width: 100%;
            height: 170px;
            object-fit: cover;
            background: #f5f5f5;
        }

        .restaurant-placeholder {
            width: 100%;
            height: 170px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fff3ed;
            color: #ff4b16;
            font-size: 55px;
        }

        .restaurant-content {
            padding: 15px;
        }

        .restaurant-content h5 {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 7px;
        }

        .restaurant-rating {
            color: #ff9d00;
            font-size: 13px;
        }

        .restaurant-address {
            color: #888;
            font-size: 12px;
            margin-top: 7px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .restaurant-btn {
            display: block;
            margin-top: 13px;
            text-align: center;
            padding: 9px;
            border-radius: 8px;
            background: #ff4b16;
            color: white;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
        }

        .restaurant-btn:hover {
            background: #e83f0c;
            color: white;
        }

        /* TABLET */

        @media (max-width: 992px) {
            .hero-content {
                width: 60%;
                padding: 40px;
            }

            .hero-image {
                width: 40%;
                font-size: 120px;
            }

            .restaurant-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        /* MOBILE */

        @media (max-width: 768px) {
            .hero {
                margin: 15px;
                min-height: auto;
            }

            .hero-content {
                width: 100%;
                padding: 30px 22px;
            }

            .hero-content h1 {
                font-size: 36px;
            }

            .hero-content p {
                font-size: 14px;
            }

            .hero-image {
                display: none;
            }

            .search-box input {
                font-size: 13px;
                padding: 12px 8px;
            }

            .search-btn {
                padding: 0 14px;
            }

            .features {
                margin: 25px 15px 0;
                grid-template-columns: 1fr;
            }

            .section {
                margin: 45px 15px 0;
            }

            .section-heading h2 {
                font-size: 21px;
            }

            .category-grid {
                gap: 12px;
                padding-left: 2px;
                padding-right: 2px;
            }

            .category-card {
                flex-basis: 105px;
                padding: 12px 7px;
            }

            .category-image {
                width: 78px;
                height: 78px;
            }

            .category-arrow {
                display: none;
            }

            .restaurant-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .category-grid {
                scroll-behavior: auto;
            }

            .category-card,
            .category-arrow {
                transition: none;
            }
        }
    </style>
</head>

<body>

    <%- include("../includes/flash.ejs") %>
    <%- include("../includes/customerNavbar.ejs") %>

    <!-- HERO SECTION -->

    <section class="hero">

        <div class="hero-content">

            <h1>
                Delicious Food
                <br>
                <span>Delivered Fast</span>
            </h1>

            <p>
                Order from your favourite restaurants and
                enjoy delicious food at your doorstep.
            </p>

            <div class="search-box">

                <i
                    class="fa-solid fa-magnifying-glass"
                    style="padding: 15px 5px 15px 15px; color:#777;"
                ></i>

                <input
                    type="text"
                    placeholder="Search for restaurants or food..."
                    aria-label="Search restaurants or food"
                >

                <button type="button" class="search-btn">
                    Search
                </button>

            </div>

        </div>

        <div class="hero-image">
            🍔
        </div>

    </section>

    <!-- FEATURES SECTION -->

    <section class="features">

        <div class="feature-card">

            <div class="feature-icon">
                <i class="fa-solid fa-truck-fast"></i>
            </div>

            <h5>Fast Delivery</h5>
            <p>Get your food on time</p>

        </div>

        <div class="feature-card">

            <div class="feature-icon">
                <i class="fa-solid fa-star"></i>
            </div>

            <h5>Best Quality</h5>
            <p>Fresh and tasty food</p>

        </div>

        <div class="feature-card">

            <div class="feature-icon">
                <i class="fa-solid fa-credit-card"></i>
            </div>

            <h5>Secure Payment</h5>
            <p>Safe and secure ordering</p>

        </div>

    </section>

    <!-- TOP CATEGORIES SECTION -->

    <section class="section">

        <div class="section-heading">

            <h2>Top Categories</h2>

            <a href="#" class="view-all">
                View All
            </a>

        </div>

        <div class="category-slider-wrapper">

            <button
                type="button"
                class="category-arrow category-arrow-left"
                id="categoryPrev"
                aria-label="Previous categories"
            >
                <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
            </button>

            <div
                class="category-grid"
                id="categorySlider"
                aria-label="Food categories"
            >

                <%
                    const categoryImages = {
                        'pizza': 'https://images.unsplash.com/photo-1513104890138-7c749659a591?auto=format&fit=crop&w=300&q=80',
                        'burger': 'https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=300&q=80',
                        'burgers': 'https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=300&q=80',
                        'biryani': 'https://images.unsplash.com/photo-1563379091339-03246963d96c?auto=format&fit=crop&w=300&q=80',
                        'chinese': 'https://images.unsplash.com/photo-1585032226651-759b368d7246?auto=format&fit=crop&w=300&q=80',
                        'dessert': 'https://images.unsplash.com/photo-1551024506-0bccd828d307?auto=format&fit=crop&w=300&q=80',
                        'desserts': 'https://images.unsplash.com/photo-1551024506-0bccd828d307?auto=format&fit=crop&w=300&q=80',
                        'sandwich': 'https://images.unsplash.com/photo-1528735602780-2552fd46c7af?auto=format&fit=crop&w=300&q=80',
                        'sandwiches': 'https://images.unsplash.com/photo-1528735602780-2552fd46c7af?auto=format&fit=crop&w=300&q=80',
                        'pasta': 'https://images.unsplash.com/photo-1473093295043-cdd812d0e601?auto=format&fit=crop&w=300&q=80',
                        'noodles': 'https://images.unsplash.com/photo-1585032226651-759b368d7246?auto=format&fit=crop&w=300&q=80',
                        'momos': 'https://images.unsplash.com/photo-1563245372-f21724e3856d?auto=format&fit=crop&w=300&q=80',
                        'cake': 'https://images.unsplash.com/photo-1578985545062-69928b1d9587?auto=format&fit=crop&w=300&q=80',
                        'cakes': 'https://images.unsplash.com/photo-1578985545062-69928b1d9587?auto=format&fit=crop&w=300&q=80',
                        'ice cream': 'https://images.unsplash.com/photo-1501446529957-6226bd447c46?auto=format&fit=crop&w=300&q=80',
                        'icecream': 'https://images.unsplash.com/photo-1501446529957-6226bd447c46?auto=format&fit=crop&w=300&q=80',
                        'south indian': 'https://images.unsplash.com/photo-1668236543090-82eba5ee5976?auto=format&fit=crop&w=300&q=80',
                        'thali': 'https://images.unsplash.com/photo-1546833999-b9f581a1996d?auto=format&fit=crop&w=300&q=80',
                        'snacks': 'https://images.unsplash.com/photo-1626082927389-6cd097cdc6ec?auto=format&fit=crop&w=300&q=80',
                        'beverages': 'https://images.unsplash.com/photo-1517701550927-30cf4ba1dba5?auto=format&fit=crop&w=300&q=80',
                        'drinks': 'https://images.unsplash.com/photo-1517701550927-30cf4ba1dba5?auto=format&fit=crop&w=300&q=80',
                        'salad': 'https://images.unsplash.com/photo-1512621776951-a57141f2eefd?auto=format&fit=crop&w=300&q=80',
                        'salads': 'https://images.unsplash.com/photo-1512621776951-a57141f2eefd?auto=format&fit=crop&w=300&q=80',
                        'rolls': 'https://images.unsplash.com/photo-1626700051175-6818013e1d4f?auto=format&fit=crop&w=300&q=80',
                        'wraps': 'https://images.unsplash.com/photo-1626700051175-6818013e1d4f?auto=format&fit=crop&w=300&q=80'
                    };
                %>

                <% categories.forEach(category => {
                    const categoryName = String(category);
                    const categoryKey = categoryName.toLowerCase().trim().replace(/\s+/g, ' ');
                    const categoryImage = categoryImages[categoryKey]
                        || 'https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=300&q=80';
                %>

                    <div class="category-card">

                        <img
                            class="category-image"
                            src="<%= categoryImage %>"
                            alt="<%= categoryName %>"
                            loading="lazy"
                            onerror="this.onerror=null;this.src='https://placehold.co/300x300/fff3ed/ff4b16?text=Food';"
                        >

                        <h6><%= categoryName %></h6>

                    </div>

                <% }) %>

            </div>

            <button
                type="button"
                class="category-arrow category-arrow-right"
                id="categoryNext"
                aria-label="Next categories"
            >
                <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
            </button>

        </div>

    </section>

    <!-- TOP RESTAURANTS SECTION -->

    <section class="section">

        <div class="section-heading">

            <h2>Top Restaurants</h2>

            <a href="#" class="view-all">
                View All
            </a>

        </div>

        <div class="restaurant-grid">

            <% restaurants.forEach(restaurant => { %>

                <div class="restaurant-card">

                    <% if (restaurant.image && restaurant.image.url) { %>

                        <img
                            src="<%= restaurant.image.url %>"
                            class="restaurant-image"
                            alt="<%= restaurant.restaurantName %>"
                            loading="lazy"
                        >

                    <% } else { %>

                        <div class="restaurant-placeholder">
                            <i class="fa-solid fa-store"></i>
                        </div>

                    <% } %>

                    <div class="restaurant-content">

                        <h5>
                            <%= restaurant.restaurantName %>
                        </h5>

                        <div class="restaurant-rating">

                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-regular fa-star"></i>

                            <span class="text-muted">4.0</span>

                        </div>

                        <div class="restaurant-address">
                            <i class="fa-solid fa-location-dot"></i>
                            <%= restaurant.address %>
                        </div>

                        <a
                            href="/customer/restaurants/<%= restaurant._id %>"
                            class="restaurant-btn"
                        >
                            View Restaurant
                        </a>

                    </div>

                </div>

            <% }) %>

        </div>

    </section>

    <div style="height: 60px;"></div>

    <%- include("../includes/customerFooter.ejs") %>

    <!-- CATEGORY SLIDER JAVASCRIPT -->

    <script>
        (() => {
            const slider = document.getElementById("categorySlider");
            const prevButton = document.getElementById("categoryPrev");
            const nextButton = document.getElementById("categoryNext");

            if (!slider || !prevButton || !nextButton) {
                return;
            }

            function updateArrowVisibility() {
                const maxScroll = slider.scrollWidth - slider.clientWidth;

                prevButton.style.visibility =
                    slider.scrollLeft <= 2 ? "hidden" : "visible";

                nextButton.style.visibility =
                    slider.scrollLeft >= maxScroll - 2 ? "hidden" : "visible";
            }

            function scrollCategories(direction) {
                slider.scrollBy({
                    left: direction * Math.max(slider.clientWidth * 0.75, 250),
                    behavior: "smooth"
                });
            }

            prevButton.addEventListener("click", () => {
                scrollCategories(-1);
            });

            nextButton.addEventListener("click", () => {
                scrollCategories(1);
            });

            slider.addEventListener("scroll", updateArrowVisibility, {
                passive: true
            });

            window.addEventListener("resize", updateArrowVisibility);

            updateArrowVisibility();
        })();
    </script>

</body>
</html>

