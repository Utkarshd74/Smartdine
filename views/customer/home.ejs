<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>SmartDine | Home</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css"
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <style>
        body {
            margin: 0;
            background: #ffffff;
            font-family: "Plus Jakarta Sans", sans-serif;
            color: #1d1d1d;
        }

        .hero {
            margin: 25px auto 0;
            max-width: 1200px;
            min-height: 420px;
            border-radius: 24px;
            background: linear-gradient(105deg, #fff3ed, #fff8f5);
            overflow: hidden;
            display: flex;
            align-items: center;
        }

        .hero-content {
            width: 52%;
            padding: 60px;
        }

        .hero-content h1 {
            font-size: 48px;
            line-height: 1.15;
            font-weight: 800;
            margin-bottom: 20px;
        }

        .hero-content h1 span {
            color: #ff4b16;
        }

        .hero-content p {
            color: #666;
            font-size: 16px;
            line-height: 1.7;
            max-width: 500px;
        }

        .search-box {
            margin-top: 28px;
            max-width: 540px;
            background: white;
            padding: 7px;
            border-radius: 12px;
            display: flex;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
        }

        .search-box input {
            flex: 1;
            border: none;
            outline: none;
            padding: 13px 15px;
            font-size: 14px;
        }

        .search-btn {
            border: none;
            background: #ff4b16;
            color: white;
            padding: 0 28px;
            border-radius: 9px;
            font-weight: 600;
        }

        .hero-image {
            width: 48%;
            height: 420px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 190px;
        }

        .features {
            max-width: 1200px;
            margin: 35px auto 0;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .feature-card {
            text-align: center;
            padding: 25px 15px;
            border: 1px solid #eeeeee;
            border-radius: 14px;
            background: white;
        }

        .feature-icon {
            width: 55px;
            height: 55px;
            margin: auto;
            border-radius: 50%;
            background: #fff1eb;
            color: #ff4b16;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
        }

        .feature-card h5 {
            margin-top: 14px;
            font-size: 16px;
            font-weight: 700;
        }

        .feature-card p {
            margin: 0;
            color: #888;
            font-size: 13px;
        }

        .section {
            max-width: 1200px;
            margin: 55px auto 0;
        }

        .section-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .section-heading h2 {
            font-size: 24px;
            font-weight: 800;
            margin: 0;
        }

        .view-all {
            color: #ff4b16;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
        }

        .category-grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 15px;
        }

        .category-card {
            border: 1px solid #eeeeee;
            border-radius: 14px;
            padding: 20px 10px;
            text-align: center;
            background: white;
            transition: 0.2s;
        }

        .category-card:hover {
            transform: translateY(-4px);
            border-color: #ff4b16;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
        }

        .category-icon {
            width: 65px;
            height: 65px;
            margin: auto;
            border-radius: 50%;
            background: #fff3ed;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ff4b16;
            font-size: 26px;
        }

        .category-card h6 {
            margin: 12px 0 0;
            font-weight: 700;
            font-size: 14px;
            text-transform: capitalize;
        }

        .restaurant-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .restaurant-card {
            background: white;
            border: 1px solid #eeeeee;
            border-radius: 14px;
            overflow: hidden;
            transition: 0.2s;
        }

        .restaurant-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
        }

        .restaurant-image {
            width: 100%;
            height: 170px;
            object-fit: cover;
            background: #f5f5f5;
        }

        .restaurant-placeholder {
            width: 100%;
            height: 170px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fff3ed;
            color: #ff4b16;
            font-size: 55px;
        }

        .restaurant-content {
            padding: 15px;
        }

        .restaurant-content h5 {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 7px;
        }

        .restaurant-rating {
            color: #ff9d00;
            font-size: 13px;
        }

        .restaurant-address {
            color: #888;
            font-size: 12px;
            margin-top: 7px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .restaurant-btn {
            display: block;
            margin-top: 13px;
            text-align: center;
            padding: 9px;
            border-radius: 8px;
            background: #ff4b16;
            color: white;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
        }

        @media (max-width: 992px) {
            .hero-content {
                width: 60%;
                padding: 40px;
            }

            .hero-image {
                width: 40%;
                font-size: 120px;
            }

            .category-grid {
                grid-template-columns: repeat(3, 1fr);
            }

            .restaurant-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 768px) {
            .hero {
                margin: 15px;
            }

            .hero-content {
                width: 100%;
                padding: 35px;
            }

            .hero-content h1 {
                font-size: 36px;
            }

            .hero-image {
                display: none;
            }

            .features {
                margin: 25px 15px 0;
                grid-template-columns: 1fr;
            }

            .section {
                margin-left: 15px;
                margin-right: 15px;
            }

            .category-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .restaurant-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
    <%- include("../includes/flash.ejs") %>
    <%- include("../includes/customerNavbar.ejs") %>

    <section class="hero">

        <div class="hero-content">

            <h1>
                Delicious Food
                <br>
                <span>Delivered Fast</span>
            </h1>

            <p>
                Order from your favourite restaurants and
                enjoy delicious food at your doorstep.
            </p>

            <div class="search-box">

                <i
                    class="fa-solid fa-magnifying-glass"
                    style="padding: 15px 5px 15px 15px; color:#777;"
                ></i>

                <input
                    type="text"
                    placeholder="Search for restaurants or food..."
                >

                <button class="search-btn">
                    Search
                </button>

            </div>

        </div>

        <div class="hero-image">
            🍔
        </div>

    </section>


    <section class="features">

        <div class="feature-card">

            <div class="feature-icon">
                <i class="fa-solid fa-truck-fast"></i>
            </div>

            <h5>Fast Delivery</h5>

            <p>
                Get your food on time
            </p>

        </div>


        <div class="feature-card">

            <div class="feature-icon">
                <i class="fa-solid fa-star"></i>
            </div>

            <h5>Best Quality</h5>

            <p>
                Fresh and tasty food
            </p>

        </div>


        <div class="feature-card">

            <div class="feature-icon">
                <i class="fa-solid fa-credit-card"></i>
            </div>

            <h5>Secure Payment</h5>

            <p>
                Safe and secure ordering
            </p>

        </div>

    </section>


    <section class="section">

        <div class="section-heading">

            <h2>
                Top Categories
            </h2>

            <a href="#" class="view-all">
                View All
            </a>

        </div>


        <div class="category-grid">

            <% categories.forEach(category => { %>

                <div class="category-card">

                    <div class="category-icon">
                        <i class="fa-solid fa-bowl-food"></i>
                    </div>

                    <h6>
                        <%= category %>
                    </h6>

                </div>

            <% }) %>

        </div>

    </section>


    <section class="section">

        <div class="section-heading">

            <h2>
                Top Restaurants
            </h2>

            <a href="#" class="view-all">
                View All
            </a>

        </div>


        <div class="restaurant-grid">

            <% restaurants.forEach(restaurant => { %>

                <div class="restaurant-card">

                    <% if (restaurant.image && restaurant.image.url) { %>

                        <img
                            src="<%= restaurant.image.url %>"
                            class="restaurant-image"
                            alt="<%= restaurant.restaurantName %>"
                        >

                    <% } else { %>

                        <div class="restaurant-placeholder">
                            <i class="fa-solid fa-store"></i>
                        </div>

                    <% } %>


                    <div class="restaurant-content">

                        <h5>
                            <%= restaurant.restaurantName %>
                        </h5>

                        <div class="restaurant-rating">
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-regular fa-star"></i>

                            <span class="text-muted">
                                4.0
                            </span>
                        </div>

                        <div class="restaurant-address">
                            <i class="fa-solid fa-location-dot"></i>
                            <%= restaurant.address %>
                        </div>

                        <a
                            href="/customer/restaurants/<%= restaurant._id %>"
                            class="restaurant-btn"
                        >
                            View Restaurant
                        </a>

                    </div>

                </div>

            <% }) %>

        </div>

    </section>


    <div style="height: 60px;"></div>
    <%- include("../includes/customerFooter.ejs") %>

</body>
</html>