<style>
    .admin-sidebar {
        position: fixed;
        top: 0;
        left: 0;
        width: 250px;
        height: 100vh;
        background: #ffffff;
        border-right: 2px solid #eeeeee;
        box-shadow: 4px 0 15px rgba(0, 0, 0, 0.05);
        z-index: 2000;
        transition: width 0.3s ease;
        overflow: hidden;
    }

    .admin-sidebar.collapsed {
        width: 75px;
    }

    .sidebar-header {
        height: 75px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 18px;
        border-bottom: 1px solid #eeeeee;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 11px;
        white-space: nowrap;
        cursor: pointer;
    }

    .brand-icon {
        width: 40px;
        height: 40px;
        min-width: 40px;
        background: #ff4b16;
        color: white;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .brand-name {
        font-size: 21px;
        font-weight: 700;
        color: #ff4b16;
    }

    .toggle-btn {
        width: 34px;
        height: 34px;
        border: 1px solid #e5e5e5;
        background: white;
        border-radius: 7px;
        cursor: pointer;
        color: #555;
    }

    .toggle-btn:hover {
        background: #fff3ed;
        color: #ff4b16;
        border-color: #ff4b16;
    }

    .admin-sidebar.collapsed .brand-name,
    .admin-sidebar.collapsed .menu-title,
    .admin-sidebar.collapsed .nav-text {
        display: none;
    }

    .admin-sidebar.collapsed .sidebar-header {
        justify-content: center;
        padding: 0;
    }

    .admin-sidebar.collapsed .toggle-btn {
        display: none;
    }

    .admin-sidebar.collapsed .brand {
        justify-content: center;
    }

    .sidebar-menu {
        padding: 22px 12px;
    }

    .menu-title {
        padding: 0 10px;
        margin-bottom: 10px;
        font-size: 11px;
        font-weight: 700;
        color: #999;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .nav-item {
        display: flex;
        align-items: center;
        gap: 13px;
        width: 100%;
        padding: 12px 13px;
        margin-bottom: 5px;
        border-radius: 8px;
        color: #555;
        text-decoration: none;
        font-size: 15px;
        font-weight: 500;
        white-space: nowrap;
    }

    .nav-item:hover {
        background: #fff3ed;
        color: #ff4b16;
    }

    .nav-item.active {
        background: #ff4b16;
        color: white;
    }

    .nav-item i {
        width: 20px;
        min-width: 20px;
        text-align: center;
    }

    .logout {
        color: #e53935;
    }

    .admin-main {
        margin-left: 250px;
        min-height: 100vh;
        transition: margin-left 0.3s ease;
    }

    .admin-main.expanded {
        margin-left: 75px;
    }

    .admin-topbar {
        position: fixed;
        top: 0;
        left: 250px;
        right: 0;
        height: 75px;
        background: white;
        border-bottom: 1px solid #eeeeee;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        padding: 0 30px;
        z-index: 1500;
        transition: left 0.3s ease;
    }

    .admin-topbar.expanded {
        left: 75px;
    }
</style>

<aside class="admin-sidebar" id="adminSidebar">

    <div class="sidebar-header">

        <div class="brand" id="smartDineLogo">
            <div class="brand-icon">
                <i class="fa-solid fa-utensils"></i>
            </div>

            <span class="brand-name">
                SmartDine
            </span>
        </div>

        <button type="button" class="toggle-btn" id="sidebarToggle">
            <i class="fa-solid fa-bars"></i>
        </button>

    </div>

    <div class="sidebar-menu">

        <div class="menu-title">
            Main Menu
        </div>

        <a href="/admin/dashboard" class="nav-item">
            <i class="fa-solid fa-house"></i>
            <span class="nav-text">Dashboard</span>
        </a>

        <a href="/admin/items" class="nav-item">
            <i class="fa-solid fa-bowl-food"></i>
            <span class="nav-text">Food Items</span>
        </a>

        <a href="/admin/orders" class="nav-item">
            <i class="fa-solid fa-receipt"></i>
            <span class="nav-text">Orders</span>
        </a>

        <!-- Donate Food -->
        <a href="/admin/donations/new" class="nav-item">
            <i class="fa-solid fa-hand-holding-heart"></i>
            <span class="nav-text">Donate Food</span>
        </a>

        <!-- Manage Customer Donations -->
        <a href="/admin/donations" class="nav-item">
            <i class="fa-solid fa-list-check"></i>
            <span class="nav-text">Manage Donations</span>
        </a>

        <!-- My Donations -->
        <a href="/admin/donations/my" class="nav-item">
            <i class="fa-solid fa-clock-rotate-left"></i>
            <span class="nav-text">My Donations</span>
        </a>

        <a href="/admin/profile" class="nav-item">
            <i class="fa-solid fa-user"></i>
            <span class="nav-text">Profile</span>
        </a>

        <a href="/admin/logout" class="nav-item logout">
            <i class="fa-solid fa-right-from-bracket"></i>
            <span class="nav-text">Logout</span>
        </a>

    </div>

</aside>

<script>
    const sidebar = document.getElementById("adminSidebar");
    const toggleBtn = document.getElementById("sidebarToggle");
    const logo = document.getElementById("smartDineLogo");
    const topbar = document.getElementById("adminTopbar");
    const main = document.querySelector(".admin-main");

    toggleBtn.addEventListener("click", function () {
        sidebar.classList.add("collapsed");
        topbar.classList.add("expanded");
        main.classList.add("expanded");
    });

    logo.addEventListener("click", function () {
        if (sidebar.classList.contains("collapsed")) {
            sidebar.classList.remove("collapsed");
            topbar.classList.remove("expanded");
            main.classList.remove("expanded");
        }
    });
</script>