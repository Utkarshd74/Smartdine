<style>
    * {
        box-sizing: border-box;
    }

    /* ================= SIDEBAR ================= */

    .admin-sidebar {
        position: fixed;
        top: 0;
        left: 0;
        width: 250px;
        height: 100vh;
        height: 100dvh;
        background: #fff;
        border-right: 1px solid #eee;
        box-shadow: 4px 0 15px #0000000d;
        z-index: 2000;
        overflow-x: hidden;
        overflow-y: auto;
        transition: width 0.3s ease, transform 0.3s ease;
    }

    .sidebar-header {
        height: 75px;
        min-height: 75px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 15px;
        border-bottom: 1px solid #eee;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        white-space: nowrap;
        cursor: pointer;
        min-width: 0;
    }

    .brand-icon {
        min-width: 40px;
        width: 40px;
        height: 40px;
        display: grid;
        place-items: center;
        background: #ff4b16;
        color: white;
        border-radius: 10px;
    }

    .brand-name {
        color: #ff4b16;
        font-weight: 700;
        font-size: 20px;
    }

    .toggle-btn {
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        border: 1px solid #eee;
        border-radius: 8px;
        background: white;
        color: #ff4b16;
        cursor: pointer;
    }

    .sidebar-menu {
        padding: 20px 12px;
    }

    .menu-title {
        color: #999;
        font-size: 11px;
        margin: 10px;
    }

    .nav-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
        margin-bottom: 5px;
        border-radius: 8px;
        color: #555;
        text-decoration: none;
        white-space: nowrap;
        transition: background 0.2s, color 0.2s;
    }

    .nav-item i {
        width: 20px;
        min-width: 20px;
        text-align: center;
    }

    .nav-item:hover,
    .nav-item.active {
        background: #fff3ed;
        color: #ff4b16;
    }

    .logout {
        color: #e53935;
    }

    /* ================= DESKTOP COLLAPSE ================= */

    .admin-sidebar.collapsed {
        width: 75px;
    }

    .admin-sidebar.collapsed .brand-name,
    .admin-sidebar.collapsed .menu-title,
    .admin-sidebar.collapsed .nav-text {
        display: none;
    }

    .admin-sidebar.collapsed .sidebar-header {
        justify-content: center;
        padding: 0;
    }

    .admin-sidebar.collapsed .brand {
        display: none;
    }

    .admin-sidebar.collapsed .nav-item {
        justify-content: center;
        padding: 12px 8px;
    }

    .admin-main {
        margin-left: 250px;
        min-width: 0;
        transition: margin-left 0.3s ease;
    }

    .admin-main.expanded {
        margin-left: 75px;
    }

    .admin-topbar {
        position: fixed;
        top: 0;
        left: 250px;
        right: 0;
        height: 75px;
        background: white;
        border-bottom: 1px solid #eee;
        display: flex;
        align-items: center;
        padding: 0 20px;
        z-index: 1500;
        transition: left 0.3s ease;
    }

    .admin-topbar.expanded {
        left: 75px;
    }

    /* ================= MOBILE BUTTON ================= */

    .mobile-menu-btn,
    .mobile-admin-brand {
        display: none;
    }

    .mobile-admin-brand a {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #111;
        text-decoration: none;
        font-size: 20px;
        font-weight: 800;
        white-space: nowrap;
    }

    .mobile-admin-brand a > i {
        color: #ff4b16;
        font-size: 21px;
    }

    .mobile-brand-accent {
        color: #ff4b16;
    }

    /* ================= MOBILE RESPONSIVE ================= */

    @media (max-width: 768px) {

        .admin-sidebar,
        .admin-sidebar.collapsed {
            width: 250px;
            max-width: 85vw;
            top: 0;
            left: 0;
            height: 100vh;
            height: 100dvh;
            transform: translateX(-105%);
            transition: transform 0.3s ease;
            z-index: 3000;
            padding-bottom: 20px;
        }

        .admin-sidebar.mobile-open {
            transform: translateX(0);
        }

        /* Mobile par labels hamesha visible */

        .admin-sidebar.collapsed .brand-name,
        .admin-sidebar.collapsed .menu-title,
        .admin-sidebar.collapsed .nav-text {
            display: initial;
        }

        .admin-sidebar.collapsed .menu-title {
            display: block;
        }

        .admin-sidebar.collapsed .sidebar-header {
            justify-content: space-between;
            padding: 0 15px;
        }

        .admin-sidebar.collapsed .brand {
            display: flex;
        }

        .admin-sidebar.collapsed .nav-item {
            justify-content: flex-start;
            padding: 12px;
        }

        .admin-sidebar .desktop-toggle {
            display: none;
        }

        /* Main content full width */

        .admin-main,
        .admin-main.expanded {
            margin-left: 0 !important;
            width: 100% !important;
            min-width: 0;
        }

        .admin-topbar,
        .admin-topbar.expanded {
            left: 0 !important;
            width: 100%;
            padding: 0 15px;
        }

        /* Mobile header: brand on left, toggle on right */

        .mobile-admin-brand {
            display: flex;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 60px;
            align-items: center;
            padding: 0 12px;
            background: #fff;
            border-bottom: 1px solid #eee;
            z-index: 2500;
        }

        .mobile-menu-btn {
            display: flex;
            position: fixed;
            top: 7px;
            right: 8px;
            left: auto;
            width: 60px;
            height: 45px;
            align-items: center;
            justify-content: center;
            background: #fff;
            color: #ff4b16;
            border: 4px solid #606060;
            border-radius: 10px;
            font-size: 23px;
            cursor: pointer;
            z-index: 3100;
            box-shadow: none;
        }

        .mobile-menu-btn:hover {
            background: #fff3ed;
            color: #e6400b;
        }

        .mobile-menu-btn i {
            color: #ff4b16;
        }

        .mobile-menu-btn.hidden {
            display: none !important;
        }
    }

    @media screen and (max-width: 768px) {

    body {
        padding-top: 70px !important;
    }

    body .admin-main {
        margin-top: 0 !important;
        padding-top: 0 !important;
    }

    body .admin-main .orders-page {
        padding-top: 20px !important;
    }
}
</style>

<!-- MOBILE-ONLY TOP HEADER -->
<div class="mobile-admin-brand">
    <a href="/admin/dashboard" aria-label="SmartDine Admin Dashboard">
        <i class="fa-solid fa-utensils"></i>
        <span>Smart<span class="mobile-brand-accent">Dine</span></span>
    </a>
</div>

<!-- MOBILE HAMBURGER -->
<button
    type="button"
    id="mobileMenuBtn"
    class="mobile-menu-btn"
    aria-label="Open navigation"
    aria-controls="adminSidebar"
    aria-expanded="false">

    <i class="fa-solid fa-bars"></i>
</button>

<!-- ADMIN SIDEBAR -->
<aside class="admin-sidebar" id="adminSidebar">

    <div class="sidebar-header">

        <a href="/admin/dashboard" class="brand">
            <div class="brand-icon">
                <i class="fa-solid fa-utensils"></i>
            </div>

            <span class="brand-name">SmartDine</span>
        </a>

        <button
            type="button"
            class="toggle-btn desktop-toggle"
            id="sidebarToggle"
            aria-label="Collapse sidebar">

            <i class="fa-solid fa-bars"></i>
        </button>

    </div>

    <div class="sidebar-menu">

        <div class="menu-title">MAIN MENU</div>

        <a href="/admin/dashboard" class="nav-item">
            <i class="fa-solid fa-house"></i>
            <span class="nav-text">Dashboard</span>
        </a>

        <a href="/admin/items" class="nav-item">
            <i class="fa-solid fa-bowl-food"></i>
            <span class="nav-text">Food Items</span>
        </a>

        <a href="/admin/orders" class="nav-item">
            <i class="fa-solid fa-receipt"></i>
            <span class="nav-text">Orders</span>
        </a>

        <a href="/admin/donations/new" class="nav-item">
            <i class="fa-solid fa-hand-holding-heart"></i>
            <span class="nav-text">Donate Food</span>
        </a>

        <a href="/admin/donations" class="nav-item">
            <i class="fa-solid fa-list-check"></i>
            <span class="nav-text">Manage Donations</span>
        </a>

        <a href="/admin/donations/my" class="nav-item">
            <i class="fa-solid fa-clock-rotate-left"></i>
            <span class="nav-text">My Donations</span>
        </a>

        <a href="/admin/profile" class="nav-item">
            <i class="fa-solid fa-user"></i>
            <span class="nav-text">Profile</span>
        </a>

        <a href="/admin/logout" class="nav-item logout">
            <i class="fa-solid fa-right-from-bracket"></i>
            <span class="nav-text">Logout</span>
        </a>

    </div>
</aside>

<script>
(() => {
    const sidebar = document.getElementById("adminSidebar");
    const mobileBtn = document.getElementById("mobileMenuBtn");
    const desktopBtn = document.getElementById("sidebarToggle");
    const topbar = document.getElementById("adminTopbar");
    const main = document.querySelector(".admin-main");

    if (!sidebar || !mobileBtn) return;

    const isMobile = () => window.matchMedia("(max-width: 768px)").matches;

    function openSidebar() {
        sidebar.classList.add("mobile-open");
        mobileBtn.classList.add("hidden");
        mobileBtn.setAttribute("aria-expanded", "true");
    }

    function closeSidebar() {
        sidebar.classList.remove("mobile-open");
        mobileBtn.classList.remove("hidden");
        mobileBtn.setAttribute("aria-expanded", "false");
    }

    /* Mobile hamburger */

    mobileBtn.addEventListener("click", (event) => {
        event.stopPropagation();

        if (isMobile()) {
            openSidebar();
        }
    });

    /* Desktop collapse button */

    if (desktopBtn) {
        desktopBtn.addEventListener("click", () => {
            if (isMobile()) return;

            const collapsed = sidebar.classList.toggle("collapsed");

            if (topbar) {
                topbar.classList.toggle("expanded", collapsed);
            }

            if (main) {
                main.classList.toggle("expanded", collapsed);
            }
        });
    }

    /* Click outside closes mobile sidebar */

    document.addEventListener("click", (event) => {
        if (
            isMobile() &&
            sidebar.classList.contains("mobile-open") &&
            !sidebar.contains(event.target)
        ) {
            closeSidebar();
        }
    });

    /* Escape closes sidebar */

    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
            closeSidebar();
        }
    });

    /* Clicking a navigation link closes sidebar on mobile */

    sidebar.querySelectorAll(".nav-item").forEach((link) => {
        if (link.pathname.replace(/\/+$/, "") ===
            window.location.pathname.replace(/\/+$/, "")) {
            link.classList.add("active");
        }

        link.addEventListener("click", () => {
            if (isMobile()) {
                closeSidebar();
            }
        });
    });

    /* Reset mobile state when switching screen sizes */

    window.addEventListener("resize", () => {
        closeSidebar();

        if (isMobile()) {
            sidebar.classList.remove("collapsed");

            if (topbar) topbar.classList.remove("expanded");
            if (main) main.classList.remove("expanded");
        }
    });

})();
</script> 



