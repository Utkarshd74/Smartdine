<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>SmartDine | Choose Account</title>

    <!-- Bootstrap CSS -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Bootstrap Icons -->
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            font-family: Arial, sans-serif;

            background: linear-gradient(
                135deg,
                #fff7ed,
                #ffedd5
            );

            display: flex;
            align-items: center;
            justify-content: center;
        }

        .container-box {
            width: 100%;
            max-width: 1100px;
            padding: 40px 25px;
            margin: auto;
        }

        /* Brand */
        .brand {
            text-align: center;
            font-size: 42px;
            font-weight: 800;
            color: #f97316;
            margin-bottom: 8px;
        }

        .subtitle {
            text-align: center;
            color: #666;
            font-size: 16px;
            margin-bottom: 40px;
        }

        /* Role cards layout */
        .roles-row {
            display: flex;
            flex-direction: row;
            flex-wrap: nowrap;
            gap: 25px;
            align-items: stretch;
        }

        .role-column {
            flex: 1 1 0;
            min-width: 0;
        }

        /* Individual card */
        .role-card {
            background: #ffffff;
            border-radius: 20px;
            padding: 35px 20px;
            text-align: center;
            height: 100%;

            display: flex;
            flex-direction: column;
            align-items: center;

            border: 2px solid transparent;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.10);

            transition: transform 0.3s ease,
                        box-shadow 0.3s ease,
                        border-color 0.3s ease;
        }

        .role-card:hover {
            transform: translateY(-8px);
            border-color: #f97316;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
        }

        /* Icons */
        .icon-box {
            width: 80px;
            height: 80px;
            flex-shrink: 0;

            margin: 0 auto 20px;
            border-radius: 50%;

            display: flex;
            align-items: center;
            justify-content: center;

            background: #fff7ed;
            color: #f97316;
            font-size: 36px;
        }

        /* Headings */
        .role-card h3 {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 12px;
            color: #222;
        }

        /* Descriptions */
        .role-card p {
            color: #777;
            font-size: 14px;
            line-height: 1.7;
            min-height: 48px;
            margin-bottom: 10px;
        }

        /* Buttons */
        .role-btn {
            display: inline-block;
            margin-top: auto;
            padding: 12px 18px;

            border-radius: 10px;
            background: #f97316;
            color: #ffffff;

            text-decoration: none;
            font-size: 14px;
            font-weight: 600;

            transition: background 0.3s ease;
        }

        .role-btn:hover {
            background: #ea580c;
            color: #ffffff;
        }

        /* Footer */
        .footer-text {
            text-align: center;
            margin-top: 35px;
            color: #777;
            font-size: 14px;
        }

        /* Tablet and mobile */
        @media (max-width: 767px) {
            body {
                align-items: flex-start;
            }

            .container-box {
                padding: 30px 20px;
            }

            .brand {
                font-size: 36px;
            }

            .subtitle {
                margin-bottom: 30px;
            }

            .roles-row {
                flex-direction: column;
                flex-wrap: wrap;
                gap: 20px;
            }

            .role-column {
                width: 100%;
                flex: 1 1 auto;
            }

            .role-card {
                padding: 30px 20px;
            }

            .role-card p {
                min-height: auto;
            }

            .footer-text {
                margin-top: 25px;
            }
        }
    </style>
</head>

<body>

    <div class="container-box">

        <!-- Brand -->
        <div class="brand">
            <i class="bi bi-egg-fried"></i>
            SmartDine
        </div>

        <p class="subtitle">
            Choose how you want to continue
        </p>

        <!-- Role Cards -->
        <div class="roles-row">

            <!-- Customer -->
            <div class="role-column">
                <div class="role-card">

                    <div class="icon-box">
                        <i class="bi bi-person-fill"></i>
                    </div>

                    <h3>Customer</h3>

                    <p>
                        Browse restaurants, explore delicious food
                        and place your orders easily.
                    </p>

                    <a href="/customer/login" class="role-btn">
                        <i class="bi bi-box-arrow-in-right"></i>
                        Login as Customer
                    </a>

                </div>
            </div>

            <!-- Admin -->
            <div class="role-column">
                <div class="role-card">

                    <div class="icon-box">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>

                    <h3>Admin</h3>

                    <p>
                        Manage your restaurant, food items
                        and incoming customer orders.
                    </p>

                    <a href="/admin/login" class="role-btn">
                        <i class="bi bi-box-arrow-in-right"></i>
                        Login as Admin
                    </a>

                </div>
            </div>

            <!-- NGO -->
            <div class="role-column">
                <div class="role-card">

                    <div class="icon-box">
                        <i class="bi bi-heart-fill"></i>
                    </div>

                    <h3>NGO</h3>

                    <p>
                        Manage surplus food donations and help
                        reduce food waste in the community.
                    </p>

                    <a href="/ngo/login" class="role-btn">
                        <i class="bi bi-box-arrow-in-right"></i>
                        Login as NGO
                    </a>

                </div>
            </div>

        </div>

        <!-- Footer -->
        <div class="footer-text">
            &copy; 2026 SmartDine — Smart Food Ordering & Donation System
        </div>

    </div>

</body>
</html>

