<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Login | SmartDine</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>

        body {
            background: #fff7ed;
            font-family: Arial, sans-serif;
        }

        .login-box {
            max-width: 450px;
            margin: 90px auto;
            background: white;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 5px 25px rgba(0, 0, 0, 0.1);
        }

        .logo {
            text-align: center;
            color: #f97316;
            font-size: 32px;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .title {
            text-align: center;
            font-size: 24px;
            font-weight: bold;
            margin-top: 15px;
        }

        .subtitle {
            text-align: center;
            color: #777;
            margin-bottom: 30px;
        }

        .form-label {
            font-weight: 600;
        }

        .form-control {
            height: 47px;
            border-radius: 8px;
        }

        .btn-login {
            width: 100%;
            height: 47px;
            background: #f97316;
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            margin-top: 10px;
        }

        .btn-login:hover {
            background: #ea580c;
        }

        .register {
            text-align: center;
            margin-top: 22px;
            color: #666;
        }

        .register a {
            color: #f97316;
            text-decoration: none;
            font-weight: bold;
        }

        .error {
            background: #fee2e2;
            color: #b91c1c;
            padding: 10px;
            border-radius: 7px;
            margin-bottom: 20px;
            text-align: center;
        }

    </style>

</head>


<body>

    <%- include("../includes/flash.ejs") %>


    <div class="login-box">

        <!-- Logo -->

        <div class="logo">
            SmartDine
        </div>


        <!-- Title -->

        <div class="title">
            Admin Login
        </div>


        <p class="subtitle">
            Login to manage your restaurant
        </p>


        <!-- Error Message -->

        <% if (typeof error !== "undefined" && error) { %>

            <div class="error">
                <%= error %>
            </div>

        <% } %>


        <!-- Login Form -->

        <form action="/admin/login" method="POST">


            <!-- Email -->

            <div class="mb-3">

                <label class="form-label">
                    Email Address
                </label>

                <input
                    type="email"
                    name="email"
                    class="form-control"
                    placeholder="Enter your email"
                    required
                    autocomplete="email"
                >

            </div>


            <!-- Password -->

            <div class="mb-3">

                <label class="form-label">
                    Password
                </label>

                <input
                    type="password"
                    name="password"
                    class="form-control"
                    placeholder="Enter your password"
                    required
                    autocomplete="current-password"
                >

            </div>


            <!-- Login Button -->

            <button
                type="submit"
                class="btn-login"
            >
                Login
            </button>

        </form>


        <!-- Register -->

        <div class="register">

            Don't have an admin account?

            <a href="/admin/register">
                Create Account
            </a>

        </div>

    </div>

    <%- include("footer.ejs") %>

</body>

</html>

