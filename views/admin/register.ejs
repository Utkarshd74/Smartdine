```html
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Register | SmartDine</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: #fff7ed;
            font-family: Arial, sans-serif;
        }

        .register-box {
            max-width: 750px;
            margin: 45px auto;
            background: white;
            padding: 35px;
            border-radius: 15px;
            box-shadow: 0 5px 25px rgba(0, 0, 0, 0.1);
        }

        .title {
            text-align: center;
            color: #f97316;
            font-weight: bold;
            font-size: 30px;
        }

        .subtitle {
            text-align: center;
            color: #777;
            margin-bottom: 30px;
        }

        .section-title {
            color: #f97316;
            font-weight: bold;
            border-bottom: 1px solid #eee;
            padding-bottom: 8px;
            margin-bottom: 18px;
        }

        .form-label {
            font-weight: 600;
        }

        .form-control {
            height: 45px;
            border-radius: 8px;
        }

        textarea.form-control {
            height: 90px;
            resize: none;
        }

        .btn-register {
            width: 100%;
            height: 47px;
            background: #f97316;
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: 600;
        }

        .btn-register:hover {
            background: #ea580c;
        }

        .login {
            text-align: center;
            margin-top: 20px;
        }

        .login a {
            color: #f97316;
            text-decoration: none;
            font-weight: bold;
        }
    </style>
</head>

<body>

    <% layout("/layouts/boilerplateA") %>

    <div class="register-box">

        <div class="title">
            SmartDine
        </div>

        <p class="subtitle">
            Create your Admin Account
        </p>


        <form action="/admin/register" method="POST">


            <!-- ================= RESTAURANT DETAILS ================= -->

            <div class="section-title">
                Restaurant Details
            </div>


            <!-- Restaurant Name -->

            <div class="mb-3">

                <label class="form-label">
                    Restaurant Name
                </label>

                <input
                    type="text"
                    name="restaurantName"
                    class="form-control"
                    placeholder="Enter restaurant name"
                    required
                >

            </div>


            <!-- Address -->

            <div class="mb-3">

                <label class="form-label">
                    Restaurant Address
                </label>

                <textarea
                    name="address"
                    class="form-control"
                    placeholder="Enter complete restaurant address"
                    required
                ></textarea>

            </div>


            <!-- Description -->

            <div class="mb-3">

                <label class="form-label">
                    Restaurant Description
                </label>

                <textarea
                    name="description"
                    class="form-control"
                    placeholder="Tell customers about your restaurant"
                ></textarea>

            </div>


            <!-- Restaurant Image -->

            <div class="mb-4">

                <label class="form-label">
                    Restaurant Logo / Image URL
                </label>

                <input
                    type="url"
                    name="image[url]"
                    class="form-control"
                    placeholder="https://example.com/restaurant.jpg"
                >

            </div>


            <!-- ================= ADMIN DETAILS ================= -->

            <div class="section-title">
                Admin Details
            </div>


            <div class="row">


                <!-- Owner Name -->

                <div class="col-md-6 mb-3">

                    <label class="form-label">
                        Owner Name
                    </label>

                    <input
                        type="text"
                        name="name"
                        class="form-control"
                        placeholder="Enter your name"
                        required
                    >

                </div>


                <!-- Phone -->

                <div class="col-md-6 mb-3">

                    <label class="form-label">
                        Phone Number
                    </label>

                    <input
                        type="tel"
                        name="phone"
                        class="form-control"
                        placeholder="Enter phone number"
                        required
                    >

                </div>

            </div>


            <!-- Email -->

            <div class="mb-3">

                <label class="form-label">
                    Email Address
                </label>

                <input
                    type="email"
                    name="email"
                    class="form-control"
                    placeholder="Enter email address"
                    required
                >

            </div>


            <!-- Password -->

            <div class="mb-4">

                <label class="form-label">
                    Password
                </label>

                <input
                    type="password"
                    name="password"
                    class="form-control"
                    placeholder="Create password"
                    required
                >

            </div>


            <!-- Submit -->

            <button type="submit" class="btn-register">
                Create Admin Account
            </button>

        </form>


        <div class="login">

            Already have an account?

            <a href="/admin/login">
                Login
            </a>

        </div>

    </div>

</body>

</html>
```
