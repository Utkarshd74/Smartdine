<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Orders | SmartDine</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css">

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200..800&display=swap" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: "Plus Jakarta Sans", sans-serif;
            background: #f8f9fa;
        }

        .admin-main {
            margin-left: 250px;
            min-height: 100vh;
            transition: margin-left 0.3s ease;
        }

        .orders-page {
            padding: 30px;
            padding-top: 100px;
        }

        .page-title {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .page-subtitle {
            color: #777;
            margin-bottom: 30px;
        }

        .order-card {
            border: none;
            border-radius: 14px;
            overflow: hidden;
        }

        .order-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 20px;
        }

        .order-id {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .customer-name {
            font-size: 14px;
            margin-bottom: 4px;
        }

        .customer-email {
            font-size: 13px;
            color: #777;
        }

        .order-date {
            font-size: 13px;
            color: #999;
            margin-top: 6px;
        }

        .order-status {
            display: inline-block;
            padding: 7px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .status-pending {
            background: #fff3cd;
            color: #856404;
        }

        .status-confirmed {
            background: #cff4fc;
            color: #055160;
        }

        .status-preparing {
            background: #cfe2ff;
            color: #084298;
        }

        .status-departed {
            background: #e2d9f3;
            color: #59359a;
        }

        .status-completed {
            background: #d1e7dd;
            color: #0f5132;
        }

        .status-cancelled {
            background: #f8d7da;
            color: #842029;
        }

        .food-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid #eee;
        }

        .food-item:last-child {
            border-bottom: none;
        }

        .food-name {
            font-size: 14px;
            font-weight: 600;
        }

        .food-quantity {
            color: #777;
            font-size: 13px;
            margin-left: 6px;
        }

        .food-price {
            font-size: 14px;
            font-weight: 600;
        }

        .order-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-top: 20px;
        }

        .total {
            font-size: 18px;
            font-weight: 700;
        }

        .status-form {
            width: 170px;
        }

        .status-select {
            width: 100%;
            font-size: 14px;
        }

        .empty-orders {
            padding: 70px 20px;
            text-align: center;
            border: none;
            border-radius: 14px;
        }

        .empty-orders i {
            font-size: 50px;
            color: #ddd;
            margin-bottom: 15px;
        }

        .empty-orders h4 {
            font-weight: 700;
        }

        @media (max-width: 768px) {

            .admin-main {
                margin-left: 75px;
            }

            .orders-page {
                padding: 20px;
                padding-top: 90px;
            }

            .order-header {
                flex-direction: column;
            }

            .order-footer {
                flex-direction: column;
                align-items: flex-start;
            }

            .status-form {
                width: 100%;
            }

        }

       
    </style>

</head>

<body>
    <%- include("../includes/flash.ejs")%>
        <%- include("../includes/navbar.ejs")%>



            <main class="admin-main">

                <div class="orders-page">

                    <h2 class="page-title">
                        Orders
                    </h2>

                    <p class="page-subtitle">
                        Manage orders from your restaurant
                    </p>


                    <% if (!orders || orders.length===0) { %>

                        <div class="card empty-orders shadow-sm">

                            <i class="fa-solid fa-receipt"></i>

                            <h4>
                                No Orders Yet
                            </h4>

                            <p class="text-muted mb-0">
                                Customer orders will appear here.
                            </p>

                        </div>

                        <% } else { %>


                            <% orders.forEach(order=> { %>

                                <div class="card order-card shadow-sm mb-4">

                                    <div class="card-body p-4">


                                        <!-- ORDER HEADER -->

                                        <div class="order-header">

                                            <div>

                                                <div class="order-id">

                                                    Order #
                                                    <%= order._id.toString().slice(-6) %>

                                                </div>


                                                <div class="customer-name">

                                                    Customer:

                                                    <strong>

                                                        <%= order.customer ? order.customer.name : "Unknown Customer" %>

                                                    </strong>

                                                </div>


                                                <% if (order.customer && order.customer.email) { %>

                                                    <div class="customer-email">

                                                        <%= order.customer.email %>

                                                    </div>

                                                    <% } %>


                                                        <div class="order-date">

                                                            <%= new Date(order.createdAt).toLocaleString("en-IN") %>

                                                        </div>

                                            </div>


                                            <!-- STATUS -->

                                            <div>

                                                <span class="order-status
                                        <%= order.status === 'Pending' ? 'status-pending' : '' %>
                                        <%= order.status === 'Confirmed' ? 'status-confirmed' : '' %>
                                        <%= order.status === 'Preparing' ? 'status-preparing' : '' %>
                                        <%= order.status === 'Departed' ? 'status-departed' : '' %>
                                        <%= order.status === 'Completed' ? 'status-completed' : '' %>
                                        <%= order.status === 'Cancelled' ? 'status-cancelled' : '' %>">

                                                    <%= order.status %>

                                                </span>

                                            </div>

                                        </div>


                                        <hr>


                                        <!-- FOOD ITEMS -->

                                        <% if (order.items && order.items.length> 0) { %>

                                            <% order.items.forEach(item=> { %>

                                                <div class="food-item">

                                                    <div>

                                                        <span class="food-name">

                                                            <%= item.name %>

                                                        </span>

                                                        <span class="food-quantity">

                                                            × <%= item.quantity %>

                                                        </span>

                                                    </div>


                                                    <div class="food-price">

                                                        ₹<%= item.price * item.quantity %>

                                                    </div>

                                                </div>

                                                <% }) %>

                                                    <% } else { %>

                                                        <p class="text-muted">

                                                            No items found in this order.

                                                        </p>

                                                        <% } %>


                                                            <!-- ORDER FOOTER -->

                                                            <div class="order-footer">


                                                                <div class="total">

                                                                    Total:
                                                                    ₹<%= order.totalAmount %>

                                                                </div>


                                                                <!-- STATUS UPDATE -->

                                                                <form action="/admin/orders/<%= order._id %>/status"
                                                                    method="POST" class="status-form">

                                                                    <select name="status"
                                                                        class="form-select status-select"
                                                                        onchange="this.form.submit()">

                                                                        <option value="Pending"
                                                                            <%=order.status==="Pending" ? "selected"
                                                                            : "" %>
                                                                            >
                                                                            Pending
                                                                        </option>


                                                                        <option value="Confirmed"
                                                                            <%=order.status==="Confirmed" ? "selected"
                                                                            : "" %>
                                                                            >
                                                                            Confirmed
                                                                        </option>


                                                                        <option value="Preparing"
                                                                            <%=order.status==="Preparing" ? "selected"
                                                                            : "" %>
                                                                            >
                                                                            Preparing
                                                                        </option>

                                                                        <option value="Departed"
                                                                            <%=order.status==="Departed" ? "selected"
                                                                            : "" %>>
                                                                            Departed
                                                                        </option>


                                                                        <option value="Completed"
                                                                            <%=order.status==="Completed" ? "selected"
                                                                            : "" %>
                                                                            >
                                                                            Completed
                                                                        </option>


                                                                        <option value="Cancelled"
                                                                            <%=order.status==="Cancelled" ? "selected"
                                                                            : "" %>
                                                                            >
                                                                            Cancelled
                                                                        </option>

                                                                    </select>

                                                                </form>

                                                            </div>

                                    </div>

                                </div>

                                <% }) %>


                                    <% } %>

                </div>

            </main>


            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js">
            </script>


            <%- include("footer.ejs") %>
</body>

</html>