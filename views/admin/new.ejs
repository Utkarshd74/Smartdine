<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Add Food Item | SmartDine</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f7f8fa;
            font-family: Arial, sans-serif;
            color: #222;
        }

        /* TOPBAR */

        .topbar {
            height: 70px;
            background: white;
            border-bottom: 1px solid #e5e5e5;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 50px;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;

            font-size: 23px;
            font-weight: 700;
            color: #ff4b16;
        }

        .logo-icon {
            width: 38px;
            height: 38px;

            background: #ff4b16;
            color: white;

            border-radius: 10px;

            display: flex;
            align-items: center;
            justify-content: center;
        }

        .back-btn {
            text-decoration: none;

            color: #555;

            border: 1px solid #ddd;

            padding: 9px 18px;

            border-radius: 7px;

            transition: 0.2s;
        }

        .back-btn:hover {
            background: #ff4b16;
            color: white;
            border-color: #ff4b16;
        }


        /* MAIN */

        .main-container {
            width: 90%;
            max-width: 850px;

            margin: 40px auto;
        }


        .page-title {
            margin-bottom: 25px;
        }

        .page-title h2 {
            font-weight: 700;
            margin-bottom: 5px;
        }

        .page-title p {
            color: #777;
            margin: 0;
        }


        /* FORM CARD */

        .form-card {
            background: white;

            border: 1px solid #e5e5e5;

            border-radius: 12px;

            padding: 35px;

            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.04);
        }


        .section-title {
            color: #ff4b16;

            font-size: 18px;

            font-weight: 700;

            border-bottom: 1px solid #eee;

            padding-bottom: 10px;

            margin-bottom: 22px;
        }


        .form-label {
            font-weight: 600;
            margin-bottom: 7px;
        }


        .form-control,
        .form-select {

            height: 46px;

            border-radius: 8px;

            border: 1px solid #ddd;
        }


        textarea.form-control {

            height: 100px;

            resize: none;
        }


        .form-control:focus,
        .form-select:focus {

            border-color: #ff4b16;

            box-shadow: 0 0 0 0.15rem rgba(255, 75, 22, 0.12);
        }


        /* AVAILABILITY */

        .availability-box {

            background: #fff7ed;

            border-radius: 8px;

            padding: 15px 18px;

            display: flex;

            align-items: center;

            justify-content: space-between;
        }


        .availability-text h6 {

            margin: 0;

            font-weight: 700;
        }


        .availability-text p {

            margin: 3px 0 0;

            color: #777;

            font-size: 14px;
        }


        /* BUTTON */

        .btn-add {

            width: 100%;

            height: 48px;

            background: #ff4b16;

            color: white;

            border: none;

            border-radius: 8px;

            font-weight: 600;

            font-size: 16px;

            margin-top: 10px;
        }


        .btn-add:hover {

            background: #e8420e;

        }


        /* FOOTER */

        footer {

            text-align: center;

            color: #999;

            margin: 35px 0 20px;

            font-size: 14px;
        }


        @media (max-width: 768px) {

            .topbar {
                padding: 0 20px;
            }

            .main-container {
                width: 94%;
            }

            .form-card {
                padding: 25px;
            }

        }

    </style>

</head>


<body>

    <% layout("/layouts/boilerplateA") %>


    <!-- TOPBAR -->

    <div class="topbar">

        <div class="logo">

            <div class="logo-icon">
                <i class="fa-solid fa-utensils"></i>
            </div>

            SmartDine

        </div>


        <a
            href="/admin/dashboard"
            class="back-btn"
        >

            <i class="fa-solid fa-arrow-left"></i>

            Back to Dashboard

        </a>

    </div>



    <!-- MAIN -->

    <div class="main-container">


        <div class="page-title">

            <h2>
                Add Food Item
            </h2>

            <p>
                Add a new food item to your restaurant menu.
            </p>

        </div>



        <!-- FORM -->

        <div class="form-card">


            <div class="section-title">

                <i class="fa-solid fa-bowl-food"></i>

                Food Information

            </div>


            <form
                action="/admin/items/new"
                method="POST"
            >


                <!-- FOOD NAME -->

                <div class="mb-4">

                    <label class="form-label">
                        Food Name
                    </label>

                    <input
                        type="text"
                        name="name"
                        class="form-control"
                        placeholder="e.g. Paneer Tikka Pizza"
                        required
                    >

                </div>



                <!-- CATEGORY + PRICE -->

                <div class="row">


                    <div class="col-md-7 mb-4">

                        <label class="form-label">
                            Category
                        </label>

                        <select
                            name="category"
                            class="form-select"
                            required
                        >

                            <option value="" selected disabled>
                                Select food category
                            </option>

                            <option value="Pizza">
                                Pizza
                            </option>

                            <option value="Burger">
                                Burger
                            </option>

                            <option value="Biryani">
                                Biryani
                            </option>

                            <option value="North Indian">
                                North Indian
                            </option>

                            <option value="South Indian">
                                South Indian
                            </option>

                            <option value="Chinese">
                                Chinese
                            </option>

                            <option value="Momos">
                                Momos
                            </option>

                            <option value="Fast Food">
                                Fast Food
                            </option>

                            <option value="Rolls">
                                Rolls
                            </option>

                            <option value="Sandwich">
                                Sandwich
                            </option>

                            <option value="Pasta">
                                Pasta
                            </option>

                            <option value="Snacks">
                                Snacks
                            </option>

                            <option value="Desserts">
                                Desserts
                            </option>

                            <option value="Ice Cream">
                                Ice Cream
                            </option>

                            <option value="Cakes">
                                Cakes
                            </option>

                            <option value="Beverages">
                                Beverages
                            </option>

                            <option value="Other">
                                Other
                            </option>

                        </select>

                    </div>



                    <div class="col-md-5 mb-4">

                        <label class="form-label">
                            Price (₹)
                        </label>

                        <input
                            type="number"
                            name="price"
                            class="form-control"
                            placeholder="e.g. 199"
                            min="1"
                            required
                        >

                    </div>

                </div>



                <!-- DESCRIPTION -->

                <div class="mb-4">

                    <label class="form-label">
                        Description
                    </label>

                    <textarea
                        name="description"
                        class="form-control"
                        placeholder="Describe the food item..."
                    ></textarea>

                </div>



                <!-- IMAGE -->

                <div class="mb-4">

                    <label class="form-label">
                        Food Image URL
                    </label>

                    <input
                        type="url"
                        name="image[url]"
                        class="form-control"
                        placeholder="https://example.com/food.jpg"
                    >

                    <small class="text-muted">
                        Add a direct URL of the food image.
                    </small>

                </div>



                <!-- AVAILABILITY -->

                <div class="mb-4">

                    <label class="form-label">
                        Availability
                    </label>


                    <div class="availability-box">


                        <div class="availability-text">

                            <h6>
                                Available for customers
                            </h6>

                            <p>
                                Customers can order this item.
                            </p>

                        </div>


                        <div class="form-check form-switch">

                            <input
                                class="form-check-input"
                                type="checkbox"
                                name="isAvailable"
                                value="true"
                                checked
                                style="width: 45px; height: 22px;"
                            >

                        </div>


                    </div>

                </div>



                <!-- SUBMIT -->

                <button
                    type="submit"
                    class="btn-add"
                >

                    <i class="fa-solid fa-plus"></i>

                    Add Food Item

                </button>


            </form>

        </div>

    </div>



<%- include("footer.ejs") %>

</body>

</html>

