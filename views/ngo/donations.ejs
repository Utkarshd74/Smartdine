<% layout("/layouts/boilerplateNGO") %>

<div class="container py-5">

    <div class="mb-4">
        <h2 class="fw-bold">
            <i class="fa-solid fa-hand-holding-heart text-success me-2"></i>
            Available Donations
        </h2>
        <p class="text-muted">Explore food donations available for your NGO.</p>
    </div>

    <% if (donations.length === 0) { %>

        <div class="alert alert-info">
            <i class="fa-solid fa-circle-info me-2"></i>
            No donations are available right now.
        </div>

    <% } else { %>

        <div class="row g-4">

            <% donations.forEach(donation => { %>

                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4">

                        <div class="card-body p-4">

                            <span class="badge bg-success mb-3">
                                <%= donation.donationType %> Donation
                            </span>

                            <h5 class="fw-bold">
                                <%= donation.restaurant
                                    ? donation.restaurant.restaurantName
                                    : "Restaurant unavailable" %>
                            </h5>

                            <p class="text-muted small">
                                <i class="fa-solid fa-location-dot me-2"></i>
                                <%= donation.restaurant
                                    ? donation.restaurant.address
                                    : "Address unavailable" %>
                            </p>

                            <hr>

                            <h6 class="fw-bold mb-3">Food Items</h6>

                            <% donation.items.forEach(item => { %>
                                <div class="d-flex justify-content-between mb-2">
                                    <span><%= item.name %></span>
                                    <span class="badge bg-light text-dark">
                                        Qty: <%= item.quantity %>
                                    </span>
                                </div>
                            <% }) %>

                            <% if (donation.message) { %>
                                <div class="bg-light rounded-3 p-3 mt-3">
                                    <small class="text-muted">Message</small>
                                    <p class="mb-0"><%= donation.message %></p>
                                </div>
                            <% } %>

                            <form
                                action="/ngo/donations/<%= donation._id %>/accept"
                                method="POST"
                                class="mt-4"
                            >
                                <button type="submit" class="btn btn-success w-100">
                                    <i class="fa-solid fa-check me-2"></i>
                                    Accept Donation
                                </button>
                            </form>

                        </div>
                    </div>
                </div>

            <% }) %>

        </div>

    <% } %>

</div>