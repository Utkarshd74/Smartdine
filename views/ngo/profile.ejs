<% layout("/layouts/boilerplateNGO") %>

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <i class="fa-solid fa-building-circle-check fa-3x text-success mb-3"></i>
                        <h2 class="fw-bold">NGO Profile</h2>
                        <p class="text-muted">Your registered information</p>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted">NGO Name</label>
                        <div class="form-control bg-light">
                            <%= ngo.name %>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted">Email</label>
                        <div class="form-control bg-light">
                            <%= ngo.email %>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted">Phone</label>
                        <div class="form-control bg-light">
                            <%= ngo.phone %>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted">Address</label>
                        <div class="form-control bg-light">
                            <%= ngo.address %>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted">About NGO</label>
                        <div class="form-control bg-light" style="min-height: 80px; height: auto;">
                            <%= ngo.description || "No description provided." %>
                        </div>
                    </div>

                    <a href="/ngo/dashboard" class="btn btn-success w-100">
                        Back to Dashboard
                    </a>

                </div>
            </div>

        </div>
    </div>

</div>